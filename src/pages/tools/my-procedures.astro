---
/*
 * 나에게 필요한 절차만 (2026-10-27 추가).
 *
 * 일본 지자체들이 쓰는 "질문형 사후 절차 안내"와 같은 방식입니다. 고인에게 해당하는 것을
 * 고르면 유족 해지·신고 체크리스트(src/data/after-checklist.js) 중 필요한 항목만 남깁니다.
 * 고른 답과 체크 표시는 이 기기에만 기억하고, 체크 표시는 "유족 해지·신고 체크리스트"와 함께 씁니다.
 */
import Base from '../../layouts/Base.astro';
import { afterChecklist, procedureQuestions } from '../../data/after-checklist.js';
---
<Base title="나에게 필요한 절차만" description="고인에게 해당하는 것만 고르면 사망신고, 재산 조회, 연금·보험, 휴대폰·카드 해지, 명의 변경 중 필요한 절차만 골라 체크리스트로 만들어 드립니다. 이 기기에서만 처리됩니다.">
  <div class="wrap narrow">
    <header class="page-head">
      <p class="crumb"><a href="/tools/">정리 도구</a></p>
      <h1>나에게 필요한 절차만</h1>
      <p class="lead">고인에게 해당하는 것을 골라 주세요. 해야 할 일만 남긴 목록을 만들어 드립니다. 잘 모르는 것은 골라 두는 편이 안전합니다.</p>
    </header>

    <section class="qs no-print">
      <h2>해당하는 것을 모두 골라 주세요</h2>
      <div class="q-grid">
        {procedureQuestions.map((q) => (
          <label class="q"><input type="checkbox" value={q.key} /><span class="mk" aria-hidden="true"></span><span>{q.label}{q.sub && <small>{q.sub}</small>}</span></label>
        ))}
      </div>
      <p class="muted" style="margin:12px 0 0">사망신고, 재산 조회, 상속을 받을지 정하기, 상속세 확인 같은 일은 누구에게나 필요해 늘 목록에 들어갑니다.</p>
    </section>

    <div class="sticky-count no-print" aria-live="polite"><span id="n">0</span>가지 할 일 · <span id="done">0</span>개 완료</div>

    <form id="mp" onsubmit="return false">
      {afterChecklist.map((g) => (
        <fieldset class="group" data-group>
          <legend>{g.title}</legend>
          {g.items.map((it) => (
            <div class="item" data-need={it.need ?? ''}>
              <label class="check">
                <input type="checkbox" name={it.id} />
                <span class="box" aria-hidden="true"></span>
                <span class="text">{it.text}</span>
              </label>
              {(it.docs || it.link) && (
                <details class="more">
                  <summary>필요한 서류·참고</summary>
                  {it.docs && <p>{it.docs}</p>}
                  {it.link && <a class="no-print" href={it.link}>관련 안내 보기 →</a>}
                </details>
              )}
            </div>
          ))}
        </fieldset>
      ))}
    </form>

    <div class="btn-row no-print" style="margin-top:24px">
      <a class="btn clay" href="/tools/deadlines/">마감 날짜 계산하기</a>
      <button class="btn ghost" type="button" id="print">이 목록 인쇄하기</button>
      <a class="btn ghost" href="/tools/after-checklist/">전체 목록 보기</a>
    </div>
    <p class="muted no-print" style="margin-top:16px">고른 답과 체크 표시는 이 기기에만 기억됩니다. 다정리 서버로는 보내지 않습니다. 정확한 서류와 절차는 각 기관에 확인하세요.</p>
  </div>
</Base>

<style>
  .qs { background: var(--bg); border-radius: 22px; padding: 22px 24px; margin-bottom: 18px; }
  .qs h2 { margin: 0 0 14px; font-size: 21px; }
  .q-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .q { display: flex; gap: 12px; align-items: center; background: #fff; border: 1.5px solid var(--line); border-radius: 14px; padding: 12px 14px; cursor: pointer; font-weight: 600; font-size: 16.5px; line-height: 1.4; }
  .q input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .q .mk { flex: none; width: 24px; height: 24px; border-radius: 7px; border: 1.5px solid #c9d6e5; display: grid; place-items: center; color: #fff; font-size: 14px; }
  .q:has(input:checked) { border-color: var(--green-2); background: #f3f7fc; }
  .q input:checked + .mk { background: var(--green-2); border-color: var(--green-2); }
  .q input:checked + .mk::after { content: '✓'; }
  .q input:focus-visible + .mk { outline: 3px solid var(--amber); outline-offset: 2px; }
  .q small { display: block; font-weight: 500; font-size: 13.5px; color: var(--ink-soft); }
  .sticky-count { position: sticky; top: 72px; z-index: 2; background: var(--green); color: #fff; font-weight: 700; border-radius: 14px; padding: 10px 16px; margin: 0 0 16px; font-size: 16px; }
  .group { border: 1px solid var(--line); background: var(--card); border-radius: var(--radius); padding: 12px 20px 8px; margin: 0 0 18px; }
  .group[hidden] { display: none; }
  legend { font-weight: 800; color: var(--green); font-size: 21px; padding: 0 8px; }
  .item { border-bottom: 1px solid var(--paper-2); padding: 12px 0; }
  .item:last-child { border-bottom: 0; }
  .check { display: flex; gap: 14px; align-items: flex-start; cursor: pointer; }
  .check input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  .box { flex: 0 0 28px; height: 28px; border: 2px solid var(--green-2); border-radius: 8px; margin-top: 2px; display: flex; align-items: center; justify-content: center; background: #fff; }
  .check input:checked + .box { background: var(--mint); border-color: var(--mint); }
  .check input:checked + .box::after { content: ''; width: 8px; height: 14px; border: solid #fff; border-width: 0 3px 3px 0; transform: rotate(45deg) translate(-1px, -1px); }
  .check input:focus-visible + .box { outline: 3px solid var(--amber); outline-offset: 2px; }
  .check input:checked ~ .text { color: var(--ink-soft); text-decoration: line-through; text-decoration-color: var(--line); }
  .more { margin: 6px 0 0 42px; }
  .more summary { cursor: pointer; font-size: 15px; color: var(--green-2); }
  .more p { font-size: 15px; color: var(--ink-soft); margin: 6px 0; }
  .more a { font-size: 15px; }
  @media (max-width: 640px) { .q-grid { grid-template-columns: 1fr; } .sticky-count { top: 60px; } }
  @media print { .more { display: block; } .more summary { display: none; } }
</style>

<script>
  import { track } from '../../scripts/analytics.js';
  const KEY = 'dajeongri-after-checklist-v1';     // 체크 표시: 유족 해지·신고 체크리스트와 함께 씀
  const QKEY = 'dajeongri-my-procedures-v1';      // 고른 답
  const qs = Array.from(document.querySelectorAll<HTMLInputElement>('.q input'));
  const form = document.getElementById('mp') as HTMLFormElement;
  const items = Array.from(form.querySelectorAll<HTMLElement>('[data-need]'));
  const boxes = Array.from(form.querySelectorAll<HTMLInputElement>('input[type=checkbox]'));
  const load = (k: string) => { try { return JSON.parse(localStorage.getItem(k) || '{}'); } catch { return {}; } };
  const put = (k: string, v: unknown) => { try { localStorage.setItem(k, JSON.stringify(v)); } catch { /* 저장이 막혀도 화면은 동작 */ } };

  function apply() {
    const on = new Set(qs.filter((q) => q.checked).map((q) => q.value));
    items.forEach((it) => { const need = it.dataset.need; it.hidden = !!need && !on.has(need); });
    form.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => { g.hidden = !g.querySelector('[data-need]:not([hidden])'); });
    const shown = items.filter((it) => !it.hidden);
    (document.getElementById('n') as HTMLElement).textContent = String(shown.length);
    (document.getElementById('done') as HTMLElement).textContent = String(shown.filter((it) => it.querySelector<HTMLInputElement>('input')!.checked).length);
  }
  const savedQ = load(QKEY);
  qs.forEach((q) => { q.checked = !!savedQ[q.value]; });
  const saved = load(KEY);
  boxes.forEach((b) => { b.checked = !!saved[b.name]; });
  apply();
  qs.forEach((q) => q.addEventListener('change', () => {
    const st: Record<string, boolean> = {};
    qs.forEach((x) => { if (x.checked) st[x.value] = true; });
    put(QKEY, st);
    apply();
  }));
  form.addEventListener('change', () => {
    const st = load(KEY);
    boxes.forEach((b) => { if (b.checked) st[b.name] = true; else delete st[b.name]; });
    put(KEY, st);
    apply();
  });
  document.getElementById('print')?.addEventListener('click', () => { track('my_procedures_print'); window.print(); });
</script>
