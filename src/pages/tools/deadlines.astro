---
import Base from '../../layouts/Base.astro';
import DeadlineCalc from '../../components/DeadlineCalc.astro';
const rules = [
  ['사망신고', '사망 사실을 안 날부터 1개월', '가족관계의 등록 등에 관한 법률 제84조'],
  ['매장한 경우 매장 신고', '매장한 날부터 30일', '장사 등에 관한 법률 제8조'],
  ['건강보험 자격상실 신고 (돌아가신 분이 지역가입자였다면 세대주가 신고)', '자격을 잃은 날(사망 다음 날)부터 14일', '국민건강보험법 제10조'],
  ['단순승인·한정승인·상속포기 결정', '상속이 시작된 것을 안 날부터 3개월', '민법 제1019조'],
  ['상속세 신고·납부', '돌아가신 달의 말일부터 6개월 (돌아가신 분이나 상속인이 외국에 주소를 둔 경우 9개월)', '상속세 및 증여세법 제67조'],
  ['상속 부동산 취득세 신고·납부', '돌아가신 달의 말일부터 6개월 (외국에 주소를 둔 상속인이 있으면 9개월)', '지방세법 제20조'],
  ['상속 자동차 이전등록', '돌아가신 달의 말일부터 6개월', '자동차등록령 제26조'],
  ['안심상속 원스톱서비스 신청', '돌아가신 달의 말일부터 1년 (주말이어도 미루지 않음)', '정부24 안내'],
  ['사망보험금 청구', '청구할 수 있는 때(보통 돌아가신 날)부터 3년', '상법 제662조'],
];
---
<Base title="상속 기한 계산기" description="돌아가신 날짜를 넣으면 사망신고, 상속포기·한정승인, 상속세·취득세, 자동차 이전등록, 보험금 청구 기한을 날짜로 계산합니다. 계산은 기기 안에서만 합니다.">
  <div class="wrap narrow article">
    <header class="page-head">
      <p class="crumb"><a href="/tools/">정리 도구</a></p>
      <h1>상속 기한 계산기</h1>
      <p class="lead">경황이 없을 때 가장 놓치기 쉬운 것이 기한입니다. 돌아가신 날을 넣으면 해야 할 일의 마감 날짜를 순서대로 보여 드립니다.</p>
    </header>

    <DeadlineCalc />

    <h2>어떤 기준으로 계산하나요</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>할 일</th><th>기한</th><th>근거</th></tr></thead>
        <tbody>{rules.map(([a, b, c]) => <tr><th scope="row" class="row-head">{a}</th><td>{b}</td><td>{c}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="muted">첫날은 세지 않고, 법이 정한 기한의 마지막 날이 토·일요일이면 다음 평일로 계산했습니다(민법 제157조·제160조·제161조). 계산기가 날짜로 보여 드리는 것은 위 표 가운데 <strong>매장 신고를 뺀 8가지</strong>입니다. 매장 신고는 매장한 날을 기준으로 하고, 국민연금 사망일시금 청구 기한(5년)은 기준일이 사람마다 달라 날짜 계산에서 뺐습니다.</p>

    <div class="calm">
      <p style="margin:0">입력한 날짜는 이 기기 안에서만 계산하고 어디에도 보내지 않습니다. "휴대폰 달력에 저장"을 누르면 마감일마다 일주일 전 알림이 들어간 달력 파일을 받을 수 있습니다.</p>
    </div>

    <section class="sources">
      <p><strong>참고한 자료 (확인일 2026년 10월 27일)</strong></p>
      <ul>
        <li><a href="https://www.law.go.kr/법령/가족관계의등록등에관한법률/제84조" rel="nofollow noopener" target="_blank">국가법령정보센터 – 가족관계의 등록 등에 관한 법률 제84조(사망신고와 그 기재사항)</a></li>
        <li><a href="https://www.law.go.kr/법령/장사등에관한법률/제8조" rel="nofollow noopener" target="_blank">국가법령정보센터 – 장사 등에 관한 법률 제8조(매장·화장 및 개장의 신고)</a></li>
        <li><a href="https://www.law.go.kr/법령/국민건강보험법/제10조" rel="nofollow noopener" target="_blank">국가법령정보센터 – 국민건강보험법 제10조(자격의 상실 시기 등)</a></li>
        <li><a href="https://www.law.go.kr/법령/민법/제1019조" rel="nofollow noopener" target="_blank">국가법령정보센터 – 민법 제1019조(승인, 포기의 기간)</a></li>
        <li><a href="https://www.law.go.kr/법령/상속세및증여세법/제67조" rel="nofollow noopener" target="_blank">국가법령정보센터 – 상속세 및 증여세법 제67조(상속세 과세표준신고)</a></li>
        <li><a href="https://www.law.go.kr/법령/지방세법/제20조" rel="nofollow noopener" target="_blank">국가법령정보센터 – 지방세법 제20조(신고 및 납부)</a></li>
        <li><a href="https://www.law.go.kr/법령/자동차등록령/제26조" rel="nofollow noopener" target="_blank">국가법령정보센터 – 자동차등록령 제26조(이전등록 신청)</a></li>
        <li><a href="https://www.korea.kr/news/policyNewsView.do?newsId=148931775" rel="nofollow noopener" target="_blank">대한민국 정책브리핑 – 안심상속 원스톱서비스(2024.7)</a></li>
        <li><a href="https://www.law.go.kr/법령/상법/제662조" rel="nofollow noopener" target="_blank">국가법령정보센터 – 상법 제662조(소멸시효)</a></li>
      </ul>
    </section>
  </div>
</Base>
