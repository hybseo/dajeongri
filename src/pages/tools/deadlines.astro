---
import Base from '../../layouts/Base.astro';
import DeadlineCalc from '../../components/DeadlineCalc.astro';
const rules = [
  ['사망신고', '사망 사실을 안 날부터 1개월', '가족관계등록법 제84조'],
  ['매장한 경우 매장 신고', '매장한 날부터 30일', '장사법 제8조'],
  ['건강보험 자격상실 신고 (지역가입자)', '14일 이내 (세대주)', '생활법령정보 안내'],
  ['상속 승인·한정승인·포기 결정', '상속 개시를 안 날부터 3개월', '민법 제1019조'],
  ['상속세 신고·납부', '돌아가신 달의 말일부터 6개월 (해외 9개월)', '상속세 및 증여세법 제67조'],
  ['상속 부동산 취득세 신고·납부', '돌아가신 달의 말일부터 6개월 (해외 9개월)', '지방세법 제20조'],
  ['상속 자동차 이전등록', '돌아가신 달의 말일부터 6개월', '지자체 안내 (늦으면 과태료)'],
  ['안심상속 원스톱서비스 신청', '돌아가신 달의 말일부터 1년', '정부24 안내'],
  ['사망보험금 청구', '돌아가신 날부터 3년', '상법 제662조'],
];
---
<Base title="상속 기한 계산기" description="돌아가신 날짜를 넣으면 사망신고, 상속포기·한정승인, 상속세·취득세, 자동차 이전등록, 보험금 청구 기한을 날짜로 계산합니다. 계산은 기기 안에서만 합니다.">
  <div class="wrap narrow article">
    <header class="page-head">
      <p class="crumb"><a href="/tools/">정리 도구</a></p>
      <h1>상속 기한 계산기</h1>
      <p class="lead">경황이 없을 때 가장 놓치기 쉬운 것이 기한입니다. 돌아가신 날을 넣으면 해야 할 일의 마감 날짜를 순서대로 보여 드립니다.</p>
    </header>

    <DeadlineCalc />

    <h2>어떤 기준으로 계산하나요</h2>
    <div class="table-wrap">
      <table>
        <thead><tr><th>할 일</th><th>기한</th><th>근거</th></tr></thead>
        <tbody>{rules.map(([a, b, c]) => <tr><th scope="row" class="row-head">{a}</th><td>{b}</td><td>{c}</td></tr>)}</tbody>
      </table>
    </div>
    <p class="muted">첫날은 세지 않고, 마지막 날이 토·일요일이면 다음 평일로 계산했습니다(민법 제157조·제160조·제161조). 매장 신고는 매장한 날을 기준으로 하고, 국민연금 사망일시금 청구 기한(5년)은 기준일이 사람마다 달라 날짜 계산에서는 뺐습니다.</p>

    <div class="calm">
      <p style="margin:0">입력한 날짜는 이 기기 안에서만 계산하고 어디에도 보내지 않습니다. "휴대폰 캘린더에 저장"을 누르면 마감일마다 일주일 전 알림이 들어간 캘린더 파일을 받을 수 있습니다.</p>
    </div>

    <section class="sources">
      <p><strong>참고한 자료 (확인일 2026년 10월 27일)</strong></p>
      <ul>
        <li><a href="https://korea.legal/wiki/가족관계의-등록-등에-관한-법률-제84조/" rel="nofollow noopener" target="_blank">가족관계등록법 제84조(사망신고)</a></li>
        <li><a href="https://www.nepla.ai/law/장사-등에-관한-법률" rel="nofollow noopener" target="_blank">장사 등에 관한 법률</a></li>
        <li><a href="https://www.easylaw.go.kr/CSP/CnpClsMain.laf?popMenu=ov&csmSeq=1141&ccfNo=2&cciNo=1&cnpClsNo=2" rel="nofollow noopener" target="_blank">찾기쉬운 생활법령정보 – 건강보험 자격상실</a></li>
        <li><a href="https://korea.legal/wiki/%ec%83%81%ec%86%8d%ed%8f%ac%ea%b8%b0-%ea%b4%80%eb%a0%a8-%eb%af%bc%eb%b2%95-%ea%b0%80%ec%82%ac%ec%86%8c%ec%86%a1%eb%b2%95%c2%b7%ea%b7%9c%ec%b9%99-%ec%a1%b0%eb%ac%b8/" rel="nofollow noopener" target="_blank">민법 제1019조(상속 승인·포기 기간)</a></li>
        <li><a href="https://www.korea.kr/news/policyNewsView.do?newsId=148941238" rel="nofollow noopener" target="_blank">대한민국 정책브리핑 – 상속세 신고 안내</a></li>
        <li><a href="https://korea.legal/wiki/상속등기는-기한이-있는지/" rel="nofollow noopener" target="_blank">상속등기 기한과 취득세(지방세법 제20조)</a></li>
        <li><a href="https://www.busan.go.kr/car/crpenaltykinds" rel="nofollow noopener" target="_blank">부산광역시 – 자동차 이전등록 지연 과태료</a></li>
        <li><a href="https://www.korea.kr/news/policyNewsView.do?newsId=148931775" rel="nofollow noopener" target="_blank">대한민국 정책브리핑 – 안심상속 원스톱서비스</a></li>
        <li><a href="https://korea.legal/wiki/%eb%b3%b4%ed%97%98%ea%b8%88%ec%b2%ad%ea%b5%ac%ea%b6%8c%ec%9d%98-%ec%86%8c%eb%a9%b8%ec%8b%9c%ed%9a%a8/" rel="nofollow noopener" target="_blank">보험금청구권의 소멸시효(상법 제662조)</a></li>
      </ul>
    </section>
  </div>
</Base>
