---
import Base from '../layouts/Base.astro';
import { noteSections } from '../data/note.js';

const isWide = (c) => c.kind === 'textarea';
---
<Base title="엔딩노트 작성기" description="재산, 보험, 디지털 계정, 물건 나눔, 연락할 사람, 남기는 말을 항목별로 쓰고 Word 파일로 내려받는 무료 엔딩노트. 작성 내용은 서버에 저장되지 않습니다.">
  <div class="wrap">
    <header class="page-head note-head">
      <p class="kicker">무료 엔딩노트</p>
      <h1>나의 엔딩노트</h1>
      <p class="lead">아는 것부터, 쓰고 싶은 칸부터 채우세요. 비워 둔 칸은 파일에 나오지 않습니다.</p>
    </header>

    <div class="notice">
      <p style="margin:0 0 8px"><strong>꼭 읽어 주세요</strong></p>
      <ul style="margin:0;padding-left:1.2em">
        <li>이 노트는 <strong>법적 효력이 있는 유언장이 아닙니다.</strong> 재산을 누구에게 줄지 법적으로 정하려면 <a href="/guide/will/">민법이 정한 방식의 유언</a>이 필요합니다.</li>
        <li><strong>계좌번호, 카드번호, 비밀번호는 적지 마세요.</strong> 기관 이름만 있어도 가족이 조회할 수 있습니다.</li>
        <li>쓰신 내용은 이 기기 안에서만 처리되고 다정리 서버로 보내지지 않습니다.</li>
      </ul>
    </div>

    <div class="import-row no-print">
      <p style="margin:0"><strong>다른 기기에서 쓰던 노트가 있나요?</strong> 다정리에서 내려받은 Word 파일을 고르면 쓰던 곳부터 이어 쓸 수 있습니다. 파일은 이 기기 안에서만 읽습니다.</p>
      <button class="btn small ghost" type="button" id="btn-import">내 파일 불러오기</button>
      <input type="file" id="file-import" accept=".docx,application/vnd.openxmlformats-officedocument.wordprocessingml.document" hidden />
    </div>

    <div class="restore no-print" id="restore" hidden>
      <p style="margin:0">이 기기에 임시저장해 둔 노트가 있습니다.</p>
      <div class="btn-row">
        <button class="btn small" type="button" id="btn-load">이어서 쓰기</button>
        <button class="btn small ghost" type="button" id="btn-forget">임시저장 지우기</button>
      </div>
    </div>

    <div class="progress-bar no-print">
      <div class="pb-track"><i id="pb-fill"></i></div>
      <span id="pb-text">13개 중 0개 작성</span>
      <span class="saved" id="saved-chip">아직 저장 안 함</span>
    </div>

    <div class="note-layout">
      <nav class="step-list no-print" aria-label="엔딩노트 항목">
        {noteSections.map((s, i) => (
          <button type="button" class="step" data-go={i}><span class="d">{i + 1}</span><span class="t">{s.title}</span></button>
        ))}
      </nav>
      <div class="note-main">
    <form id="note" onsubmit="return false" autocomplete="off">
      {noteSections.map((s, i) => (
        <section class="sec" data-section={s.id} data-type={s.type}>
          <p class="sec-no no-print">{i + 1} / {noteSections.length}</p>
          <h2><span class="num">{i + 1}</span>{s.title}</h2>
          {s.hint && <p class="why"><span aria-hidden="true">💡</span><span><strong>도움말</strong> {s.hint}</span></p>}

          {s.type === 'fields' && (
            <div class="fields">
              {s.fields.map((f) => (
                <div class={`field ${isWide(f) ? 'wide' : ''}`}>
                  {f.kind === 'choice' ? (
                    <fieldset class="choice" data-field={f.id} data-label={f.label}>
                      <legend>{f.label}</legend>
                      {f.options.map((o) => (
                        <label class="opt"><input type="radio" name={`${s.id}.${f.id}`} value={o} /> <span>{o}</span></label>
                      ))}
                      {f.hint && <small>{f.hint}{f.guide && <> <a href={f.guide}>안내 보기</a></>}</small>}
                    </fieldset>
                  ) : (
                    <label>
                      <span class="lab">{f.label}</span>
                      {f.kind === 'textarea'
                        ? <textarea rows="3" data-field={f.id} data-label={f.label}></textarea>
                        : <input type={f.kind === 'date' ? 'date' : 'text'} data-field={f.id} data-label={f.label} />}
                      {f.hint && <small>{f.hint}</small>}
                    </label>
                  )}
                </div>
              ))}
            </div>
          )}

          {s.type === 'list' && (
            <>
              <div class="rows" data-rows={s.id}></div>
              <button class="btn small ghost no-print add" type="button" data-add={s.id}>+ 한 줄 더</button>
              <template id={`tpl-${s.id}`}>
                <div class="row" data-row>
                  <div class="row-fields">
                    {s.cols.map((c) => (
                      <label class={isWide(c) ? 'wide' : ''}>
                        <span class="lab">{c.label}</span>
                        {c.kind === 'choice' ? (
                          <select data-col={c.id}>
                            <option value="">선택</option>
                            {c.options.map((o) => <option value={o}>{o}</option>)}
                          </select>
                        ) : c.kind === 'textarea' ? (
                          <textarea rows="3" data-col={c.id} placeholder={c.placeholder ?? ''}></textarea>
                        ) : (
                          <input type="text" data-col={c.id} placeholder={c.placeholder ?? ''} />
                        )}
                      </label>
                    ))}
                  </div>
                  <button class="remove no-print" type="button" data-remove>이 줄 지우기</button>
                </div>
              </template>
            </>
          )}
        </section>
      ))}
    </form>
        <div class="pager no-print">
          <button class="btn ghost" type="button" id="btn-prev">← 이전</button>
          <button class="btn" type="button" id="btn-next">다음 →</button>
        </div>
      </div>
      <aside class="preview no-print" aria-label="미리보기">
        <div class="pv-cap"><span>미리보기 (Word 파일 모양)</span></div>
        <div class="sheet" id="preview"></div>
        <div class="btn-row pv-btns">
          <button class="btn small" type="button" data-proxy="btn-docx">Word로 내려받기</button>
          <button class="btn small ghost" type="button" data-proxy="btn-save">이 기기에 임시저장</button>
        </div>
      </aside>
    </div>

    <div class="actions no-print">
      <h2>다 쓰셨나요?</h2>
      <p class="muted">한 번에 다 채우지 않아도 됩니다. 쓰다가 멈출 때는 임시저장을 누르거나 파일로 내려받아 두세요.</p>
      <div class="btn-row">
        <button class="btn clay" type="button" id="btn-docx">Word 파일로 내려받기</button>
        <button class="btn ghost" type="button" id="btn-print">인쇄하기</button>
      </div>
      <div class="btn-row" style="margin-top:12px">
        <button class="btn small ghost" type="button" id="btn-save">이 기기에 임시저장</button>
        <button class="btn small ghost" type="button" id="btn-clear">처음부터 다시 쓰기</button>
      </div>
      <p class="status muted" id="status" role="status" aria-live="polite"></p>
      <p class="muted">여러 사람이 함께 쓰는 컴퓨터라면 임시저장을 쓰지 마시고, 다 쓴 뒤 파일로만 내려받으세요.</p>

      <div class="keep">
        <h3>잃어버리지 않게 보관하는 법</h3>
        <p class="muted" style="margin:0 0 12px">다정리는 쓰신 내용을 보관하지 않습니다. 그래서 파일을 잃어버리면 저희도 되살려 드릴 수 없습니다.</p>
        <ol>
          <li><strong>Word 파일을 두 곳에 두세요.</strong> 휴대폰과 컴퓨터, 또는 USB와 클라우드처럼요. 이 파일을 다시 불러오면 언제든 이어 쓸 수 있습니다.</li>
          <li><strong>인쇄본을 가족이 아는 곳에 두세요.</strong> 파일은 비밀번호에 막힐 수 있지만 종이는 바로 펼쳐 볼 수 있습니다. 어디 두었는지 가족 한 명에게 꼭 알려 주세요.</li>
          <li><strong>1년에 한 번 다시 열어 고치세요.</strong> 계좌, 보험, 연락처는 해마다 바뀝니다.</li>
        </ol>
        <button class="btn small" type="button" id="btn-remind">해마다 다시 보기 알림을 달력에 넣기</button>
        <p class="muted" style="margin:8px 0 0;font-size:14.5px">휴대폰 달력에 1년 뒤부터 해마다 한 번 알림이 들어가는 파일을 받습니다. 노트 내용은 들어가지 않습니다.</p>
      </div>
    </div>
  </div>
</Base>

<style>
  .note-head { padding-bottom: 0; }
  .progress-bar { display: flex; align-items: center; gap: 14px; margin: 18px 0 20px; font-size: 15px; color: var(--ink-soft); position: sticky; top: 72px; z-index: 3; background: #fff; padding: 10px 0; }
  .pb-track { flex: 1; max-width: 420px; height: 9px; background: var(--mint-t); border-radius: 99px; overflow: hidden; }
  .pb-track i { display: block; height: 100%; width: 0; background: var(--amber); border-radius: 99px; transition: width .3s; }
  .saved { margin-left: auto; font-size: 14px; font-weight: 700; padding: 6px 12px; border-radius: 99px; background: var(--bg); color: var(--ink-soft); }
  .saved.ok { background: var(--mint-t); color: #1f6e55; }
  .note-layout { display: grid; grid-template-columns: 240px minmax(0, 1fr) 300px; gap: 22px; align-items: start; }
  .step-list { position: sticky; top: 140px; background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 8px; display: grid; gap: 2px; }
  .step { display: flex; align-items: center; gap: 10px; width: 100%; text-align: left; font: inherit; font-size: 15.5px; color: var(--ink); background: none; border: 0; border-radius: 10px; padding: 9px 10px; cursor: pointer; line-height: 1.35; }
  .step:hover { background: var(--bg); }
  .step .d { flex: none; width: 26px; height: 26px; border-radius: 50%; border: 1.5px solid var(--line); display: grid; place-items: center; font-size: 12.5px; font-weight: 700; color: var(--ink-soft); }
  .step.done .d { background: var(--mint); border-color: var(--mint); color: #fff; }
  .step.done .d { font-size: 0; }
  .step.done .d::after { content: '✓'; font-size: 13px; }
  .step[aria-current='step'] { background: var(--clay-soft); font-weight: 800; }
  .step[aria-current='step'] .d { border-color: var(--amber); color: var(--clay); }
  .sec { background: var(--card); border: 1px solid var(--line); border-radius: 22px; padding: 10px 28px 26px; margin: 0 0 18px; }
  .sec:not(.is-current) { display: none; }
  .sec-no { margin: 18px 0 0; font-size: 14px; font-weight: 800; color: var(--clay); }
  .sec h2 { margin: 2px 0 10px; display: flex; align-items: center; gap: 12px; font-size: 28px; }
  .num { display: none; }
  .why { display: flex; gap: 10px; background: var(--bg); border-radius: 14px; padding: 12px 16px; font-size: 15.5px; color: var(--ink-soft); margin: 6px 0 20px; }
  .why strong { color: var(--green); margin-right: 4px; }
  .fields { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 18px; }
  .field.wide, .fields .field:has(textarea), .fields .field:has(fieldset) { grid-column: 1 / -1; }
  label { display: block; }
  .lab, .choice legend { display: block; font-weight: 700; font-size: 16px; margin-bottom: 6px; color: var(--ink); }
  input[type=text], input[type=date], textarea, select {
    width: 100%; font: inherit; font-size: 17px; padding: 12px 14px; border: 1.5px solid var(--line); border-radius: 12px; background: #fff; color: var(--ink);
  }
  textarea { resize: vertical; min-height: 96px; }
  input:focus, textarea:focus, select:focus { border-color: var(--green-2); outline: none; box-shadow: 0 0 0 3px rgba(44, 82, 130, .15); }
  small { display: block; color: var(--ink-soft); font-size: 15px; margin-top: 6px; }
  .choice { border: 0; padding: 0; margin: 0; }
  .choice legend { padding: 0; }
  .opt { display: inline-flex; align-items: center; gap: 8px; margin: 4px 16px 4px 0; font-size: 17px; cursor: pointer; }
  .opt input { width: 22px; height: 22px; accent-color: var(--green-2); }
  .rows { display: grid; gap: 12px; margin: 12px 0; }
  .row { border: 1px solid var(--line); border-radius: 14px; padding: 14px; background: var(--bg); }
  .row-fields { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
  .row-fields label.wide { grid-column: 1 / -1; }
  .row-fields:has(> label:nth-child(2):last-child) { grid-template-columns: 1fr; }
  .add { width: 100%; border-style: dashed !important; }
  .remove { margin-top: 10px; background: none; border: 0; color: var(--ink-soft); font: inherit; font-size: 15px; text-decoration: underline; cursor: pointer; padding: 4px 0; }
  .remove:hover { color: var(--clay); }
  .pager { display: flex; justify-content: space-between; gap: 10px; margin: 4px 0 8px; }
  .pager .btn { width: auto; }
  .import-row { display: flex; align-items: center; justify-content: space-between; gap: 12px 18px; flex-wrap: wrap; border: 1.5px dashed #c9d6e5; border-radius: var(--radius); padding: 14px 20px; margin: 16px 0 0; font-size: 15.5px; color: var(--ink-soft); }
  .import-row strong { color: var(--ink); }
  .import-row .btn { flex: none; }
  .import-row :global(.import-msg) { flex-basis: 100%; margin: 0; font-weight: 700; color: var(--green); }
  .keep { margin-top: 28px; background: var(--navy-t); border-radius: 22px; padding: 22px 24px; }
  .keep h3 { margin: 0 0 6px; font-size: 21px; color: var(--green); }
  .keep ol { margin: 0 0 16px; padding-left: 1.3em; display: grid; gap: 8px; }
  .keep li { line-height: 1.6; }
  .restore { background: var(--clay-soft); border-radius: var(--radius); padding: 16px 20px; margin: 16px 0; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .preview { position: sticky; top: 140px; }
  .pv-cap { font-size: 14px; color: var(--ink-soft); margin-bottom: 8px; }
  .sheet { background: #fff; border: 1px solid var(--line); border-radius: 6px; box-shadow: 0 16px 40px rgba(22, 33, 44, .10); padding: 22px 20px; min-height: 320px; font-size: 13px; line-height: 1.6; overflow: hidden; }
  .sheet :global(h4) { font-size: 15px; font-weight: 800; color: var(--green); margin: 0 0 8px; border-bottom: 2px solid var(--green); padding-bottom: 4px; }
  .sheet :global(table) { font-size: 12px; margin-bottom: 10px; }
  .sheet :global(th), .sheet :global(td) { padding: 4px 6px; border: 1px solid var(--line); }
  .sheet :global(.empty) { color: #9aa5b1; }
  .pv-btns { margin-top: 12px; }
  .pv-btns .btn { flex: 1; }
  .actions { margin-top: 32px; }
  .actions h2 { margin-top: 32px; }
  .status { min-height: 1.5em; margin-top: 12px; font-weight: 700; color: var(--green); }
  @media (max-width: 1100px) {
    .note-layout { grid-template-columns: 220px minmax(0, 1fr); }
    .preview { display: none; }
  }
  @media (max-width: 760px) {
    .progress-bar { top: 60px; }
    .note-layout { grid-template-columns: 1fr; }
    .step-list { position: static; display: flex; overflow-x: auto; gap: 6px; padding: 6px; border-radius: 14px; }
    .step { flex: none; width: auto; white-space: nowrap; padding: 8px 12px; }
    .fields, .row-fields { grid-template-columns: 1fr; }
    .sec { padding: 6px 16px 18px; }
    .saved { display: none; }
  }
  @media print {
    .sec, .sec:not(.is-current) { display: block; border: 0; padding: 0; break-inside: auto; }
    .why { background: none; padding: 0; }
    .row { background: #fff; }
    input, textarea, select { border: 0; border-bottom: 1px solid #999; border-radius: 0; padding: 4px 0; }
    .note-layout { display: block; }
  }
</style>

<script>
  import { noteSections } from '../data/note.js';
  import { track } from '../scripts/analytics.js';

  type Row = Record<string, string>;
  type NoteData = Record<string, Record<string, string> | Row[]>;

  const KEY = 'dajeongri-note-v1';
  const form = document.getElementById('note') as HTMLFormElement;
  const status = document.getElementById('status') as HTMLElement;
  const say = (msg: string) => { status.textContent = msg; };

  /* ── 줄 추가·삭제 ─────────────────────────── */
  function addRow(sectionId: string, values?: Row) {
    const tpl = document.getElementById(`tpl-${sectionId}`) as HTMLTemplateElement;
    const rows = form.querySelector(`[data-rows="${sectionId}"]`) as HTMLElement;
    const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    if (values) {
      node.querySelectorAll<HTMLInputElement>('[data-col]').forEach((el) => { el.value = values[el.dataset.col!] ?? ''; });
    }
    rows.appendChild(node);
    return node;
  }
  function resetRows() {
    form.querySelectorAll<HTMLElement>('[data-rows]').forEach((rows) => {
      rows.innerHTML = '';
      addRow(rows.dataset.rows!);
    });
  }
  form.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const add = t.closest<HTMLElement>('[data-add]');
    if (add) {
      const row = addRow(add.dataset.add!);
      row.querySelector<HTMLElement>('[data-col]')?.focus();
      return;
    }
    if (t.closest('[data-remove]')) {
      const row = t.closest('[data-row]') as HTMLElement;
      const rows = row.parentElement as HTMLElement;
      row.remove();
      if (!rows.children.length) addRow(rows.dataset.rows!);
      dirty = true;
    }
  });
  /* ── 모으기·채우기 ───────────────────────── */
  function collect(): NoteData {
    const data: NoteData = {};
    form.querySelectorAll<HTMLElement>('[data-section]').forEach((sec) => {
      const id = sec.dataset.section!;
      if (sec.dataset.type === 'fields') {
        const obj: Record<string, string> = {};
        sec.querySelectorAll<HTMLElement>('[data-field]').forEach((el) => {
          if (el.tagName === 'FIELDSET') {
            const checked = el.querySelector<HTMLInputElement>('input:checked');
            obj[el.dataset.field!] = checked ? checked.value : '';
          } else {
            obj[el.dataset.field!] = (el as HTMLInputElement).value.trim();
          }
        });
        data[id] = obj;
      } else {
        const rows: Row[] = [];
        sec.querySelectorAll<HTMLElement>('[data-row]').forEach((r) => {
          const row: Row = {};
          r.querySelectorAll<HTMLInputElement>('[data-col]').forEach((el) => { row[el.dataset.col!] = el.value.trim(); });
          rows.push(row);
        });
        data[id] = rows;
      }
    });
    return data;
  }
  function fill(data: NoteData) {
    form.reset();
    resetRows();
    form.querySelectorAll<HTMLElement>('[data-section]').forEach((sec) => {
      const id = sec.dataset.section!;
      const v = data[id];
      if (!v) return;
      if (sec.dataset.type === 'fields') {
        const obj = v as Record<string, string>;
        sec.querySelectorAll<HTMLElement>('[data-field]').forEach((el) => {
          const val = obj[el.dataset.field!] ?? '';
          if (el.tagName === 'FIELDSET') {
            el.querySelectorAll<HTMLInputElement>('input').forEach((r) => { r.checked = r.value === val; });
          } else {
            (el as HTMLInputElement).value = val;
          }
        });
      } else {
        const rows = (v as Row[]).filter((r) => Object.values(r).some(Boolean));
        if (!rows.length) return;
        const box = sec.querySelector<HTMLElement>('[data-rows]')!;
        box.innerHTML = '';
        rows.forEach((r) => addRow(id, r));
      }
    });
  }
  const isEmpty = (d: NoteData) => Object.values(d).every((v) =>
    Array.isArray(v) ? v.every((r) => !Object.values(r).some(Boolean)) : !Object.values(v).some(Boolean));

  /* ── 저장하지 않은 내용이 있을 때 창 닫기 경고 ── */
  let dirty = false;
  window.addEventListener('beforeunload', (e) => {
    if (!dirty) return;
    e.preventDefault();
    e.returnValue = '';   // 브라우저가 "저장하지 않은 내용이 있습니다" 안내를 띄웁니다(문구는 브라우저가 정합니다).
  });

  /* 아이폰·아이패드 사파리: 7일 넘게 열지 않으면 임시저장이 지워질 수 있습니다(홈 화면 앱은 예외). */
  const isIOS = /iPhone|iPad|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const isApp = window.matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone === true;
  const iosTip = isIOS && !isApp
    ? ' 아이폰·아이패드에서는 7일 넘게 열지 않으면 임시저장이 지워질 수 있습니다. 공유 버튼에서 "홈 화면에 추가"를 해 두시면 더 오래 보관됩니다.'
    : '';

  /* ── 임시저장 (이 기기에만) ───────────────── */
  function storageGet(): NoteData | null {
    try { const s = localStorage.getItem(KEY); return s ? JSON.parse(s) : null; } catch { return null; }
  }
  const restoreBox = document.getElementById('restore') as HTMLElement;
  if (storageGet()) restoreBox.hidden = false;

  document.getElementById('btn-load')?.addEventListener('click', () => {
    const d = storageGet();
    if (d) { fill(d); say('임시저장한 내용을 불러왔습니다.'); refresh(); }
    restoreBox.hidden = true;
  });
  document.getElementById('btn-forget')?.addEventListener('click', () => {
    try { localStorage.removeItem(KEY); localStorage.removeItem(KEY + '-meta'); } catch { /* 무시 */ }
    restoreBox.hidden = true;
    say('이 기기에 저장된 노트를 지웠습니다.');
  });
  document.getElementById('btn-save')?.addEventListener('click', () => {
    try {
      localStorage.setItem(KEY, JSON.stringify(collect()));
      say('이 기기에 임시저장했습니다. 다음에 이 페이지를 열면 이어서 쓸 수 있습니다. 다만 브라우저 기록을 지우거나 기기를 바꾸면 사라지니, Word 파일로도 받아 두세요.' + iosTip);
      markSaved();
      dirty = false;
    } catch {
      say('이 브라우저에서는 임시저장을 할 수 없습니다. 파일로 내려받아 보관해 주세요.');
    }
  });
  let armed = false;
  document.getElementById('btn-clear')?.addEventListener('click', (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    if (!armed) {
      armed = true;
      btn.textContent = '한 번 더 누르면 모두 지워집니다';
      setTimeout(() => { armed = false; btn.textContent = '처음부터 다시 쓰기'; }, 4000);
      return;
    }
    armed = false;
    btn.textContent = '처음부터 다시 쓰기';
    form.reset();
    resetRows();
    try { localStorage.removeItem(KEY); localStorage.removeItem(KEY + '-meta'); } catch { /* 무시 */ }
    restoreBox.hidden = true;
    dirty = false;
    refresh();
    say('모두 지웠습니다.');
  });

  /* ── 인쇄 ────────────────────────────────── */
  document.getElementById('btn-print')?.addEventListener('click', () => { track('note_print'); window.print(); });

  /* ── 작성 시작 횟수 (한 번만) ─────────────── */
  let started = false;
  form.addEventListener('input', () => { if (!started) { started = true; track('note_start'); } });

  /* ── Word 파일 만들기 ────────────────────── */
  document.getElementById('btn-docx')?.addEventListener('click', async () => {
    const data = collect();
    if (isEmpty(data)) { say('아직 쓴 내용이 없습니다. 한 칸이라도 채운 뒤 내려받아 주세요.'); return; }
    say('파일을 만드는 중입니다…');
    try {
      const { buildDocx } = await import('../scripts/note-docx.js');
      const blob = await buildDocx(noteSections, data);
      const me = (data.me ?? {}) as Record<string, string>;
      // 휴대폰에 설정된 시간대 기준 오늘 날짜. (toISOString 은 세계 표준시라 한국 아침에는 전날로 나옵니다.)
      const now = new Date();
      const today = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
      const day = me.date || today;
      const name = (me.name || '').replace(/[\\/:*?"<>|]/g, '').trim();
      const filename = `엔딩노트${name ? '_' + name : ''}_${day}.docx`;
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = filename;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 2000);
      track('note_download');
      dirty = false;
      say(`"${filename}" 파일을 내려받았습니다. 안전한 곳에 보관하고, 어디 두었는지 가족 한 명에게 알려 두세요. 다른 기기에서 이 파일을 "내 파일 불러오기"로 고르면 이어 쓸 수 있습니다.`);
    } catch (err) {
      console.error(err);
      say('파일을 만들지 못했습니다. 인쇄하기로 저장하시거나 잠시 후 다시 시도해 주세요.');
    }
  });


  /* ── 내 파일 불러오기 (다른 기기에서 이어 쓰기) ── */
  const importBtn = document.getElementById('btn-import') as HTMLButtonElement;
  const fileInput = document.getElementById('file-import') as HTMLInputElement;
  let importArmed = false;
  importBtn.addEventListener('click', () => {
    if (!isEmpty(collect()) && !importArmed) {
      importArmed = true;
      importBtn.textContent = '한 번 더 누르면 지금 쓴 내용 대신 파일을 불러옵니다';
      setTimeout(() => { importArmed = false; importBtn.textContent = '내 파일 불러오기'; }, 5000);
      return;
    }
    importArmed = false;
    importBtn.textContent = '내 파일 불러오기';
    fileInput.value = '';
    fileInput.click();
  });
  fileInput.addEventListener('change', async () => {
    const file = fileInput.files?.[0];
    if (!file) return;
    const box = document.querySelector('.import-row') as HTMLElement;
    const tell = (msg: string) => { say(msg); let p = box.querySelector<HTMLElement>('.import-msg'); if (!p) { p = document.createElement('p'); p.className = 'import-msg'; p.setAttribute('role', 'status'); box.appendChild(p); } p.textContent = msg; };
    if (file.size > 20 * 1024 * 1024) { tell('파일이 너무 큽니다. 다정리에서 내려받은 엔딩노트 Word 파일을 골라 주세요.'); return; }
    tell('파일을 읽는 중입니다…');
    try {
      const { readNoteFile } = await import('../scripts/note-docx.js');
      const r = await readNoteFile(file, noteSections);
      if (!r.ok) {
        tell(r.reason === 'notzip'
          ? 'Word(.docx) 파일이 아닙니다. 다정리에서 내려받은 엔딩노트 파일을 골라 주세요.'
          : '이 파일에는 이어 쓰기 정보가 없습니다. 다정리에서 내려받은 그대로의 파일을 골라 주세요. (Word에서 고쳐 다시 저장한 파일은 불러올 수 없습니다.)');
        track('note_import_fail');
        return;
      }
      fill(r.data as NoteData);
      restoreBox.hidden = true;
      show(0);
      dirty = false;
      const when = r.savedAt ? new Date(r.savedAt) : null;
      const whenText = when && !isNaN(+when) ? ` (${when.getFullYear()}년 ${when.getMonth() + 1}월 ${when.getDate()}일에 받은 파일)` : '';
      tell(`파일을 불러왔습니다${whenText}. 이어서 쓰신 뒤 다시 Word 파일로 내려받아 두세요.`);
      chip.textContent = '파일에서 불러옴';
      chip.classList.remove('ok');
      track('note_import');
    } catch (err) {
      console.error(err);
      tell('파일을 읽지 못했습니다. 다정리에서 내려받은 엔딩노트 Word 파일이 맞는지 확인해 주세요.');
    }
  });

  /* ── 해마다 다시 보기 알림 (.ics) ─────────── */
  document.getElementById('btn-remind')?.addEventListener('click', () => {
    const p2 = (n: number) => String(n).padStart(2, '0');
    const d = new Date(); d.setFullYear(d.getFullYear() + 1);
    const e = new Date(d); e.setDate(e.getDate() + 1);
    const ymd = (x: Date) => `${x.getFullYear()}${p2(x.getMonth() + 1)}${p2(x.getDate())}`;
    const stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d+Z$/, 'Z');
    const esc = (t: string) => t.replace(/[\\,;]/g, (m) => '\\' + m);
    const ics = [
      'BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//dajeongri//note-reminder//KO', 'CALSCALE:GREGORIAN',
      'BEGIN:VEVENT', `UID:dajeongri-note-review-${ymd(new Date())}-${Math.random().toString(36).slice(2, 8)}`, `DTSTAMP:${stamp}`,
      `DTSTART;VALUE=DATE:${ymd(d)}`, `DTEND;VALUE=DATE:${ymd(e)}`, 'RRULE:FREQ=YEARLY',
      `SUMMARY:${esc('엔딩노트 다시 보기')}`,
      `DESCRIPTION:${esc('보관해 둔 엔딩노트를 열어 바뀐 것(계좌, 보험, 연락처, 휴대폰)을 고쳐 주세요. 다정리 엔딩노트에서 "내 파일 불러오기"로 이어 쓸 수 있습니다. https://dajeongri.com/note/')}`,
      'BEGIN:VALARM', 'TRIGGER:PT9H', 'ACTION:DISPLAY', `DESCRIPTION:${esc('엔딩노트 다시 보기')}`, 'END:VALARM',
      'END:VEVENT', 'END:VCALENDAR',
    ].join('\r\n');
    const url = URL.createObjectURL(new Blob([ics], { type: 'text/calendar;charset=utf-8' }));
    const a = document.createElement('a');
    a.href = url; a.download = '엔딩노트_해마다_다시보기.ics';
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 2000);
    track('note_reminder');
    say('달력 파일을 받았습니다. 파일을 열면 휴대폰 달력에 "엔딩노트 다시 보기"가 해마다 한 번 들어갑니다.');
  });

  /* ── 한 칸씩 보기: 단계 목록 · 이전/다음 · 진행률 · 미리보기 ── */
  const secs = Array.from(form.querySelectorAll<HTMLElement>('[data-section]'));
  const steps = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-go]'));
  const prevBtn = document.getElementById('btn-prev') as HTMLButtonElement;
  const nextBtn = document.getElementById('btn-next') as HTMLButtonElement;
  const preview = document.getElementById('preview') as HTMLElement;
  let cur = 0;
  const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const filled = (v: unknown) => Array.isArray(v) ? v.some((r) => Object.values(r).some(Boolean)) : Object.values((v ?? {}) as object).some(Boolean);
  function show(i: number, focus = false) {
    cur = Math.max(0, Math.min(secs.length - 1, i));
    secs.forEach((s, k) => s.classList.toggle('is-current', k === cur));
    steps.forEach((b, k) => { if (k === cur) b.setAttribute('aria-current', 'step'); else b.removeAttribute('aria-current'); });
    prevBtn.disabled = cur === 0;
    prevBtn.style.visibility = cur === 0 ? 'hidden' : 'visible';
    nextBtn.textContent = cur === secs.length - 1 ? '다 썼어요 →' : `다음: ${noteSections[cur + 1].title} →`;
    refresh();
    if (focus) secs[cur].scrollIntoView({ behavior: 'smooth', block: 'start' });
  }
  function refresh() {
    const data = collect();
    let n = 0;
    noteSections.forEach((s, k) => { const ok = filled(data[s.id]); if (ok) n++; steps[k]?.classList.toggle('done', ok); });
    (document.getElementById('pb-fill') as HTMLElement).style.width = `${Math.round((n / noteSections.length) * 100)}%`;
    (document.getElementById('pb-text') as HTMLElement).textContent = `${noteSections.length}개 중 ${n}개 작성`;
    const s = noteSections[cur];
    const v = data[s.id];
    let html = `<h4>${cur + 1}. ${esc(s.title)}</h4>`;
    if (!filled(v)) html += '<p class="empty">아직 쓰지 않았습니다. 비워 둔 항목은 파일에 나오지 않습니다.</p>';
    else if (s.type === 'fields') {
      html += '<table>' + s.fields.filter((f) => (v as Record<string, string>)[f.id]).map((f) => `<tr><th>${esc(f.label)}</th><td>${esc((v as Record<string, string>)[f.id])}</td></tr>`).join('') + '</table>';
    } else {
      const rows = (v as Row[]).filter((r) => Object.values(r).some(Boolean));
      html += '<table><tr>' + s.cols.map((c) => `<th>${esc(c.label)}</th>`).join('') + '</tr>' + rows.map((r) => '<tr>' + s.cols.map((c) => `<td>${esc(r[c.id] ?? '')}</td>`).join('') + '</tr>').join('') + '</table>';
    }
    preview.innerHTML = html;
  }
  steps.forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.go), true)));
  prevBtn.addEventListener('click', () => show(cur - 1, true));
  nextBtn.addEventListener('click', () => {
    if (cur === secs.length - 1) { document.querySelector('.actions')?.scrollIntoView({ behavior: 'smooth' }); return; }
    show(cur + 1, true);
  });
  form.addEventListener('input', () => { refresh(); markUnsaved(); dirty = true; });
  form.addEventListener('click', () => setTimeout(refresh, 0));
  document.querySelectorAll<HTMLElement>('[data-proxy]').forEach((b) => b.addEventListener('click', () => document.getElementById(b.dataset.proxy!)?.click()));

  /* 저장 표시: 임시저장을 누른 때를 보여 줍니다(자동 저장은 하지 않습니다. 함께 쓰는 컴퓨터를 위해). */
  const chip = document.getElementById('saved-chip') as HTMLElement;
  function markSaved() {
    const t = new Date();
    chip.textContent = `✓ 이 기기에 저장됨 · ${String(t.getHours()).padStart(2, '0')}:${String(t.getMinutes()).padStart(2, '0')}`;
    chip.classList.add('ok');
    try { localStorage.setItem(KEY + '-meta', JSON.stringify({ at: t.toISOString(), n: noteSections.filter((s) => filled(collect()[s.id])).length })); } catch { /* 무시 */ }
  }
  function markUnsaved() { if (chip.classList.contains('ok')) { chip.textContent = '고친 내용은 아직 저장 안 함'; chip.classList.remove('ok'); } }

  resetRows();
  show(0);
</script>
