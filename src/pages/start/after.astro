---
/*
 * "가족을 떠나보냈을 때"는 /after/ 와 같은 곳으로 보냅니다.
 * 시작하기 목록에서도, 첫 화면에서도 같은 안내를 보게 하기 위한 연결 페이지입니다.
 */
import Base from '../../layouts/Base.astro';
---
<Base title="가족을 떠나보냈을 때" description="가족을 떠나보낸 뒤 해야 할 일을 날짜순으로 안내합니다." noindex>
  <div class="wrap narrow">
    <header class="page-head">
      <h1>가족을 떠나보냈을 때</h1>
      <p class="lead">깊은 애도를 전합니다. 필요한 것만 날짜순으로 정리해 두었습니다.</p>
    </header>
    <a class="btn clay" href="/after/">떠나보낸 뒤 안내로 가기</a>
  </div>
</Base>
