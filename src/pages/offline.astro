---
/*
 * 인터넷이 끊겼고, 아직 휴대폰에 저장되지 않은 페이지를 열려고 할 때 보여 주는 안내입니다.
 * 서비스 워커(sw.js)가 이 페이지를 미리 저장해 두었다가 대신 보여 줍니다.
 */
import Base from '../layouts/Base.astro';
---
<Base title="인터넷 연결 없음" description="인터넷 연결이 없을 때 보이는 안내입니다." noindex>
  <div class="wrap narrow">
    <header class="page-head">
      <h1>인터넷에 연결되어 있지 않습니다</h1>
      <p class="lead">이 페이지는 아직 휴대폰에 저장되지 않았습니다. 아래 기능은 인터넷 없이도 쓸 수 있습니다.</p>
    </header>
    <div class="btn-row">
      <a class="btn clay" href="/note/">엔딩노트 작성기</a>
      <a class="btn ghost" href="/checklist/">체크리스트</a>
    </div>
  </div>
</Base>
