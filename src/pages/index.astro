---
/*
 * 첫 화면 (2026-11-16 개편 시안 2: "한 줄의 길")
 *   마지막을 준비하는 때부터 떠나보낸 뒤 6개월까지를 한 줄의 길(5개 지점)로 보여 주고,
 *   지금 계신 지점을 누르면 그때 할 일을 순서대로 보여 줍니다.
 *   PC: 지점이 가로로 한 줄, 고른 지점의 할 일이 그 아래 한 칸에.
 *   휴대폰: 지점이 세로로 늘어서고, 고른 지점 바로 아래에 할 일이 펼쳐집니다(같은 HTML, CSS만 다름).
 *   → 검색 · 3분 진단 → 대표 도구(엔딩노트) → 바로 쓸 수 있는 도구 → 확인한 정보만 → 마음도 미리 → 설치
 * 엔딩노트 카드는 이 기기에 임시저장한 노트가 있으면 실제 진행(몇 칸 썼는지)을,
 * 없으면 "예시" 표시와 함께 보기 그림을 보여 줍니다. 노트 내용은 화면에만 쓰고 어디로도 보내지 않습니다.
 */
import Base from '../layouts/Base.astro';
import { noteSections } from '../data/note.js';
import { checklist } from '../data/checklist.js';
import { items as funeralHomes } from '../data/funeral-homes.js';
import SearchBox from '../components/SearchBox.astro';

const checkCount = checklist.reduce((n, g) => n + g.items.length, 0);
const exampleDone = ['me', 'bank', 'insurance', 'contacts'];
const exampleRows = noteSections.filter((s) => exampleDone.includes(s.id)).concat(noteSections.filter((s) => s.id === 'letters'));
const fhCount = funeralHomes.length.toLocaleString('ko-KR');

// 길 위의 다섯 지점. when = 할 일 앞에 붙는 때.
const stops = [
  {
    id: 'healthy', who: '나를 위해', label: '건강할 때', ill: 'situ-me',
    head: '아직 건강할 때, 한 주에 하나씩', text: '통장과 보험, 연락할 사람, 남기고 싶은 말을 미리 적어 두면 남은 가족이 헤매지 않습니다.',
    steps: [
      { when: '이번 주', href: '/note/', t: '엔딩노트 첫 칸 쓰기', d: `${noteSections.length}개 항목 중 아는 것부터` },
      { when: '이번 달', href: '/checklist/', t: '생전정리 체크리스트', d: `서류·재산·디지털·물건 ${checkCount}가지` },
      { when: '마음이 정해지면', href: '/guide/will/', t: '유언 남기는 법', d: '법적 효력이 있는 방식' },
      { when: '마음이 정해지면', href: '/guide/life-sustaining/', t: '사전연명의료의향서', d: '등록 기관과 준비물' },
    ],
    cta: { href: '/note/', t: '엔딩노트 쓰기 시작' }, more: { href: '/start/me/', t: '한 주에 하나씩 정리하는 순서' },
  },
  {
    id: 'care', who: '가족 곁에서', label: '돌봄이 필요할 때', ill: 'situ-parents',
    head: '부모님이나 배우자의 돌봄이 시작될 때', text: '말을 꺼내는 것부터 어렵습니다. 대화 순서와 요양·의료 결정에 필요한 제도를 모았습니다.',
    steps: [
      { when: '먼저', href: '/guide/talk-parents/', t: '부모님께 이야기 꺼내기', d: '거부감 없이 시작하는 말' },
      { when: '돌봄 정하기', href: '/guide/care-home/', t: '요양원·요양병원, 장기요양 등급', d: '신청 순서와 비용' },
      { when: '의료 결정', href: '/guide/hospice/', t: '호스피스·연명의료', d: '받을 수 있는 곳과 결정 방법' },
      { when: '판단이 어려워지면', href: '/guide/guardianship/', t: '후견 제도', d: '대신 결정할 사람 정하기' },
    ],
    cta: { href: '/start/parents/', t: '부모님과 함께 정리하기' }, more: null,
  },
  {
    id: 'urgent', who: '나와 가족 모두', label: '시간이 많지 않을 때', ill: 'situ-time',
    head: '위중한 진단을 받으셨다면, 꼭 필요한 것부터', text: '모든 것을 다 하지 않아도 됩니다. 남은 가족이 가장 곤란해지는 것부터 순서대로 챙깁니다.',
    steps: [
      { when: '오늘', href: '/start/urgent/', t: '꼭 남겨 둘 것부터', d: '연락처·통장·보험·원하는 장례' },
      { when: '이번 주', href: '/guide/hospice/', t: '호스피스와 연명의료 결정', d: '본인 뜻을 남기는 방법' },
      { when: '미리 알아 두기', href: '/tools/funeral-homes/', t: '장례식장 찾기', d: `전국 ${fhCount}곳 · e하늘 가격 바로가기` },
      { when: '할 수 있다면', href: '/guide/letters/', t: '남기는 말·편지', d: '받는 사람별 예시 문장' },
    ],
    cta: { href: '/start/urgent/', t: '시간이 많지 않을 때의 순서' }, more: null,
  },
  {
    id: 'days', who: '떠나보낸 분', label: '떠나보낸 직후', ill: 'situ-after',
    head: '첫 3일, 장례를 치르며', text: '경황이 없을 때 놓치기 쉬운 것들입니다. 돌아가신 곳에 따라 먼저 할 일이 다릅니다.',
    steps: [
      { when: '바로', href: '/after/first-days/#where', t: '돌아가신 곳별 첫 행동', d: '병원·집·요양원·사고·해외' },
      { when: '첫날', href: '/tools/funeral-homes/', t: '장례식장 고르고 가격 확인', d: '빈소 수·편의시설·e하늘 가격' },
      { when: '첫날', href: '/tools/obituary/', t: '부고 문자 보내기', d: '빈칸만 채우면 문안 완성' },
      { when: '발인 전', href: '/after/first-days/', t: '사망진단서 여러 부·화장 신고', d: '장례 일정과 비용 쓸 때 주의' },
    ],
    cta: { href: '/after/first-days/', t: '첫 3일 안내 보기' }, more: null,
  },
  {
    id: 'months', who: '떠나보낸 분', label: '그 뒤 6개월', ill: 'costs',
    head: '기한이 있는 일을 날짜순으로', text: '상속은 기한을 넘기면 되돌리기 어렵습니다. 돌아가신 날만 넣으면 마감일을 한 번에 계산합니다.',
    steps: [
      { when: '한 달 안', href: '/after/first-month/', t: '사망신고와 안심상속 조회', d: '재산·빚을 한 번에 찾기' },
      { when: '3개월 안', href: '/after/three-months/', t: '상속 받을지 정하기', d: '승인·한정승인·상속포기' },
      { when: '6개월 안', href: '/after/six-months/', t: '상속세 신고·명의 변경', d: '부동산·자동차·예금' },
      { when: '천천히', href: '/after/belongings/', t: '유품 정리', d: '업체 맡기기 전에 확인할 것' },
    ],
    cta: { href: '/tools/deadlines/', t: '상속 기한 계산하기' }, more: { href: '/after/', t: '날짜순 전체 안내' },
  },
];

const tools = [
  { href: '/tools/deadlines/', t: '상속 기한 계산기', d: '돌아가신 날만 넣으면 마감 8가지' },
  { href: '/tools/funeral-homes/', t: '장례식장 찾기', d: `전국 ${fhCount}곳 · e하늘 가격 바로가기`, fresh: true },
  { href: '/tools/inheritance-tax/', t: '상속세 가늠 계산기', d: '세금이 나올지, 대략 얼마인지' },
  { href: '/tools/my-procedures/', t: '나에게 필요한 절차만', d: '질문에 답하면 할 일 목록' },
  { href: '/tools/obituary/', t: '부고 문자 만들기', d: '문안 고르고 바로 보내기' },
  { href: '/checklist/', t: '생전정리 체크리스트', d: `${checkCount}가지 할 일 · 진행률 표시` },
];
---
<Base description="마지막을 준비하는 일부터 떠나보낸 뒤의 일까지. 건강할 때의 엔딩노트, 돌봄과 연명의료, 장례식장 찾기, 첫 3일 안내, 상속 기한 계산까지 지금 상황에 맞는 할 일을 순서대로. 무료, 가입 없이, 쓴 내용은 내 기기에만.">
  <section class="hero">
    <div class="wrap">
      <h1>마지막을 준비하는 일부터<br /> 떠나보낸 뒤의 일까지</h1>
      <p class="lead">마지막을 준비하는 분, 가족을 떠나보낼 준비를 하는 분, 가족을 떠나보낸 분께. 지금 계신 곳을 고르면 그때 할 일을 순서대로 알려 드립니다.</p>

      <ol class="road" data-road aria-label="마지막을 준비하는 때부터 떠나보낸 뒤까지">
        {stops.map((s, i) => (
          <li class="stop">
            <button class="stop-btn" type="button" id={`stop-${s.id}`} aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`panel-${s.id}`}>
              <span class="dot" aria-hidden="true"></span>
              <span class="who">{s.who}</span>
              <span class="lbl">{s.label}</span>
            </button>
            <div class="panel" id={`panel-${s.id}`} role="region" aria-labelledby={`stop-${s.id}`} hidden={i !== 0}>
              <div class="p-intro">
                <img src={`/illust/${s.ill}.svg`} alt="" width="320" height="240" />
                <h2>{s.head}</h2>
                <p>{s.text}</p>
                <a class="btn clay" href={s.cta.href}>{s.cta.t}</a>
                {s.more && <a class="p-more" href={s.more.href}>{s.more.t}</a>}
              </div>
              <ul class="steps-list">
                {s.steps.map((st) => (
                  <li>
                    <span class="when">{st.when}</span>
                    <a href={st.href}><b>{st.t}</b><small>{st.d}</small></a>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
      <script is:inline>
        /* 휴대폰은 다섯 지점이 한눈에 보이도록 처음에는 모두 접어 둡니다. 화면을 그리기 전에 해야 화면이 밀리지 않습니다. */
        if (window.matchMedia('(max-width: 760px)').matches) {
          document.querySelectorAll('[data-road] .stop-btn').forEach(function (b) { b.setAttribute('aria-expanded', 'false'); });
          document.querySelectorAll('[data-road] .panel').forEach(function (p) { p.hidden = true; });
        }
      </script>

      <div class="find">
        <SearchBox id="home-q" label="찾는 내용이 있으신가요?" />
        <p class="find-side">
          <a href="/check/">어디서부터 할지 모르겠다면, 질문 3개로 시작점 찾기</a>
          <span>모두 무료 · 회원가입 없음 · 쓴 내용은 내 기기에만</span>
        </p>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="feature">
      <div class="f-copy">
        <h2>남은 사람이 헤매지 않도록,<br />엔딩노트 한 권</h2>
        <p class="muted">다정리의 대표 도구입니다. 차 한잔하면서, 한 주에 하나씩. 통장과 보험, 연락할 사람, 남기고 싶은 말까지 {noteSections.length}개 항목을 한 권에 모아 Word 파일과 종이로 보관합니다.</p>
        <div class="btn-row">
          <a class="btn clay" href="/note/" data-note-cta>엔딩노트 쓰기 시작</a>
          <a class="btn ghost" href="/tools/print/">손으로 쓸 빈 노트 인쇄</a>
        </div>
      </div>
      <div class="f-stage">
        <div class="window">
          <p class="bubble">이번 주는 '은행·증권' 칸을 써 볼까요?</p>
          <img src="/illust/hero-table.svg" alt="부모님과 자녀가 식탁에 마주 앉아 엔딩노트를 함께 쓰는 그림" width="640" height="420" loading="lazy" />
        </div>
        <a class="note-card" href="/note/" data-note-card>
          <div class="nc-left">
            <span class="nc-k" data-nc-label>예시 · 우리 가족에게</span>
            <strong>나의 엔딩노트</strong>
            <span class="ring" style="--p:31%"><i data-nc-count>4/{noteSections.length}</i></span>
          </div>
          <ul class="nc-list" data-nc-list>
            {exampleRows.map((s) => <li class={exampleDone.includes(s.id) ? 'd' : ''}><span class="c"></span>{s.title}</li>)}
          </ul>
        </a>
      </div>
    </section>

    <section class="more-tools">
      <h2>바로 쓸 수 있는 도구</h2>
      <p class="muted" style="margin-top:-6px">모두 무료이고, 입력한 내용은 다정리로 보내지지 않습니다.</p>
      <div class="mini">
        {tools.map((t) => <a href={t.href}><span>{t.t}{t.fresh && <em>새 기능</em>}<small>{t.d}</small></span>›</a>)}
      </div>
      <p class="all"><a href="/tools/">정리 도구 전체 보기</a><a href="/guide/">정리 가이드 전체 보기</a></p>
    </section>

    <section class="trust">
      <div>
        <h2>확인한 정보만 씁니다</h2>
        <p>가이드마다 내용 확인일을 적고, 법과 제도에 관한 내용에는 국가법령정보센터의 법령·판례 출처를 붙입니다. 법이 바뀌면 고친 날짜를 남깁니다.</p>
      </div>
      <ul class="tg">
        <li><b>확인일 표시</b>모든 가이드 맨 위</li>
        <li><b>출처 공개</b>법령·판례·공공기관</li>
        <li><b>공식 기관 연결</b><a href="/links/">정부24, 건강보험공단 등</a></li>
        <li><b>서버 저장 없음</b><a href="/privacy/">쓴 내용은 내 기기에만</a></li>
      </ul>
    </section>

    <section class="letter">
      <img src="/illust/letter.svg" alt="부모님이 책상에서 편지를 쓰는 그림" width="420" height="320" loading="lazy" />
      <div>
        <h2>마음도 미리 전할 수 있습니다</h2>
        <p class="muted">고맙다는 말, 미안하다는 말, 남기고 싶은 부탁. 엔딩노트 마지막 칸 "남기는 말"에 적어 두세요.</p>
      </div>
      <a class="btn" href="/guide/letters/">편지 쓰는 법</a>
    </section>

    <section class="hide-in-app install-row">
      <div>
        <h2>휴대폰에 앱처럼 설치하세요</h2>
        <p class="muted">홈 화면에 다정리 아이콘을 만들어 두면 한 번에 열리고, 인터넷이 없어도 엔딩노트를 쓸 수 있습니다.</p>
      </div>
      <div class="btn-row">
        <button class="btn" type="button" data-install hidden>지금 바로 설치하기</button>
        <a class="btn ghost" href="/app/">설치 방법 보기</a>
      </div>
    </section>
  </div>
</Base>

<style>
  /* ---------- 첫 화면: 한 줄의 길 ---------- */
  .hero { background: #fff; padding: 44px 0 40px; border-bottom: 1px solid var(--line); }
  .hero h1 { font-size: clamp(30px, 4.4vw, 50px); letter-spacing: -0.05em; line-height: 1.22; margin: 0 0 14px; color: var(--green); }
  .hero .lead { max-width: 46em; margin: 0 0 34px; font-size: 19px; line-height: 1.6; }

  .road { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); position: relative; }
  .stop { display: contents; }
  /* 지점들을 잇는 선 (PC: 가로) */
  .road::before { content: ''; position: absolute; left: 10%; right: 10%; top: 13px; height: 3px; background: var(--line); border-radius: 2px; }
  .stop-btn { grid-row: 1; position: relative; display: flex; flex-direction: column; align-items: center; gap: 4px; background: none; border: 0; padding: 0 6px 22px; font: inherit; color: var(--ink-soft); cursor: pointer; text-align: center; }
  .dot { width: 29px; height: 29px; border-radius: 50%; background: #fff; border: 3px solid #c9d6e5; margin-bottom: 8px; transition: transform .15s; }
  .who { font-size: 14px; font-weight: 700; color: var(--ink-soft); }
  .lbl { font-size: 19px; font-weight: 800; color: var(--ink); letter-spacing: -0.03em; line-height: 1.3; }
  .stop-btn:hover .dot { border-color: var(--green-2); }
  .stop-btn[aria-expanded='true'] .dot { background: var(--amber); border-color: var(--amber); transform: scale(1.18); box-shadow: 0 0 0 6px #fcefd9; }
  .stop-btn[aria-expanded='true'] .lbl { color: var(--green-2); }
  .stop-btn[aria-expanded='true']::after { content: ''; position: absolute; bottom: 0; left: 50%; width: 20px; height: 20px; background: var(--warm); transform: translate(-50%, 50%) rotate(45deg); border-radius: 3px; }
  .stop-btn:focus-visible { outline: 3px solid rgba(44, 82, 130, .35); outline-offset: 4px; border-radius: 12px; }

  .panel { grid-row: 2; grid-column: 1 / -1; background: var(--warm); border-radius: 26px; padding: 30px 34px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr); gap: 34px; align-items: start; }
  .panel[hidden] { display: none; }
  .p-intro img { width: 120px; height: 90px; border-radius: 16px; background: #fff; }
  .p-intro h2 { font-size: 26px; line-height: 1.3; margin: 14px 0 8px; color: var(--green); }
  .p-intro p { margin: 0 0 20px; color: var(--ink); font-size: 17px; line-height: 1.65; }
  .p-more { display: block; margin-top: 14px; font-weight: 700; color: var(--green-2); }
  .steps-list { list-style: none; margin: 0; padding: 0; background: #fff; border-radius: 20px; }
  .steps-list li { display: grid; grid-template-columns: 124px minmax(0, 1fr); align-items: center; border-top: 1px solid var(--line); }
  .steps-list li:first-child { border-top: 0; }
  .when { font-size: 14.5px; font-weight: 800; color: var(--clay); padding: 0 0 0 20px; }
  .steps-list a { display: block; padding: 15px 20px 15px 6px; text-decoration: none; color: var(--ink); }
  .steps-list a:hover b { color: var(--green-2); text-decoration: underline; }
  .steps-list b { display: block; font-size: 17.5px; letter-spacing: -0.02em; }
  .steps-list small { display: block; font-size: 14.5px; color: var(--ink-soft); margin-top: 2px; }

  .find { margin-top: 26px; display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 28px; align-items: center; }
  .find-side { margin: 0; display: grid; gap: 8px; font-size: 16px; }
  .find-side a { font-weight: 800; color: var(--green-2); }
  .find-side span { color: #1f6e55; font-weight: 700; font-size: 15px; }

  /* ---------- 대표 도구 · 아래 묶음 ---------- */
  .feature { margin-top: 64px; display: grid; grid-template-columns: 1fr 1.02fr; gap: 40px; align-items: center; }
  .feature h2 { font-size: clamp(26px, 3.2vw, 36px); line-height: 1.3; margin: 0 0 12px; }
  .feature .btn-row { margin-top: 20px; }
  .f-stage { position: relative; padding-bottom: 120px; }
  .window { position: relative; border-radius: 32px; background: var(--warm); overflow: hidden; }
  .window img { display: block; width: 100%; height: auto; }
  .bubble { position: absolute; left: 22px; top: 18px; margin: 0; background: #fff; border-radius: 16px; padding: 9px 14px; font-size: 14.5px; font-weight: 700; color: var(--green); box-shadow: 0 8px 20px rgba(22, 33, 44, .08); }
  .note-card { position: absolute; left: -28px; bottom: 0; width: min(470px, 92%); background: #fff; border-radius: 20px; box-shadow: 0 24px 60px rgba(22, 33, 44, .16); padding: 18px 20px; transform: rotate(-1.5deg); display: grid; grid-template-columns: 140px 1fr; gap: 14px; align-items: center; text-decoration: none; color: var(--ink); }
  .note-card:hover { color: var(--ink); transform: rotate(-1.5deg) translateY(-2px); }
  .nc-left strong { display: block; font-size: 20px; font-weight: 800; color: var(--green); letter-spacing: -0.03em; margin: 2px 0 8px; line-height: 1.3; }
  .nc-k { font-size: 13.5px; font-weight: 700; color: var(--green-2); }
  .ring { width: 70px; height: 70px; border-radius: 50%; background: conic-gradient(var(--amber) 0 var(--p), var(--navy-t) var(--p) 100%); display: grid; place-items: center; }
  .ring i { width: 54px; height: 54px; border-radius: 50%; background: #fff; display: grid; place-items: center; font-style: normal; font-weight: 800; color: var(--green); font-size: 15px; }
  .nc-list { list-style: none; margin: 0; padding: 0; }
  .nc-list li { display: flex; align-items: center; gap: 9px; padding: 5px 0; border-top: 1px dashed var(--line); font-size: 14.5px; }
  .nc-list li:first-child { border-top: 0; }
  .nc-list .c { width: 20px; height: 20px; border-radius: 6px; border: 1.5px solid var(--line); flex: none; display: grid; place-items: center; font-size: 12px; color: #fff; }
  .nc-list li.d .c { background: var(--mint); border-color: var(--mint); }
  .nc-list li.d .c::after { content: '✓'; }

  .more-tools { margin-top: 56px; }
  .mini { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 18px; }
  .mini a { background: var(--bg); border-radius: 16px; padding: 15px 18px; font-weight: 700; font-size: 17px; display: flex; justify-content: space-between; align-items: center; gap: 8px; text-decoration: none; color: var(--ink); }
  .mini a:hover { background: var(--navy-t); color: var(--green); }
  .mini small { display: block; color: var(--ink-soft); font-weight: 500; font-size: 14px; }
  .mini em { font-style: normal; font-size: 12.5px; background: var(--mint-t); color: #1f6e55; border-radius: 6px; padding: 1px 6px; margin-left: 6px; vertical-align: 2px; }
  .all { margin: 14px 0 0; font-weight: 700; display: flex; gap: 20px; flex-wrap: wrap; }
  .all a { color: var(--green-2); }

  .trust { margin-top: 64px; background: var(--green); border-radius: 28px; padding: 40px 44px; display: grid; grid-template-columns: 1.1fr 1fr; gap: 36px; align-items: center; color: #c6d3e2; }
  .trust h2 { color: #fff; margin: 0 0 10px; }
  .trust p { margin: 0; }
  .tg { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; list-style: none; margin: 0; padding: 0; }
  .tg li { background: rgba(255, 255, 255, .08); border-radius: 14px; padding: 14px 16px; font-size: 15px; }
  .tg b { display: block; color: #fff; font-size: 17px; }
  .tg a { color: #c6d3e2; }
  .letter { margin-top: 20px; background: var(--warm); border-radius: 28px; padding: 26px 40px; display: grid; grid-template-columns: 240px 1fr auto; gap: 30px; align-items: center; }
  .letter img { width: 100%; height: auto; border-radius: 18px; }
  .letter h2 { margin: 0 0 6px; color: var(--green); }
  .letter p { margin: 0; }
  .install-row { margin-top: 56px; display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; border-top: 1px solid var(--line); padding-top: 28px; }
  .install-row h2 { margin: 0 0 4px; font-size: 24px; }
  .install-row p { margin: 0; }

  @media (max-width: 960px) {
    .panel { grid-template-columns: minmax(0, 1fr); gap: 20px; padding: 24px; }
    .find { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    .feature { grid-template-columns: 1fr; gap: 24px; }
    .f-stage { padding-bottom: 0; }
    .note-card { position: relative; left: auto; bottom: auto; width: auto; margin: -40px 14px 0; transform: none; grid-template-columns: auto 1fr; }
    .note-card:hover { transform: none; }
    .nc-list { display: none; }
    .nc-left { display: contents; }
    .note-card { grid-template-areas: 'ring k' 'ring t'; grid-template-columns: auto 1fr; column-gap: 16px; row-gap: 0; align-items: center; }
    .nc-k { grid-area: k; align-self: end; }
    .nc-left strong { grid-area: t; align-self: start; margin: 0; }
    .ring { grid-area: ring; }
    .mini { grid-template-columns: 1fr 1fr; }
    .trust { grid-template-columns: 1fr; padding: 28px 22px; }
    .letter { grid-template-columns: 1fr; padding: 22px; }
    .letter img { max-width: 320px; }
  }
  /* 휴대폰·좁은 태블릿: 길을 세로로, 고른 지점 바로 아래에 할 일이 펼쳐집니다 */
  @media (max-width: 760px) {
    .hero { padding: 26px 0 30px; }
    .hero h1 { font-size: 28px; }
    .hero .lead { font-size: 16.5px; margin-bottom: 18px; }
    .road { display: block; }
    .road::before { left: 13px; right: auto; top: 22px; bottom: 22px; width: 3px; height: auto; }
    .stop { display: block; position: relative; }
    .stop-btn { display: grid; grid-template-columns: 29px minmax(0, 1fr) 20px; grid-template-areas: 'dot lbl chev' 'dot who chev'; column-gap: 12px; align-items: center; width: 100%; padding: 9px 0; text-align: left; }
    .dot { grid-area: dot; margin: 0; }
    .lbl { grid-area: lbl; font-size: 18.5px; }
    .who { grid-area: who; font-size: 13.5px; }
    .stop-btn::before { content: ''; grid-area: chev; width: 10px; height: 10px; border-right: 2.5px solid var(--ink-soft); border-bottom: 2.5px solid var(--ink-soft); transform: rotate(45deg); margin-top: -4px; }
    .stop-btn[aria-expanded='true']::before { transform: rotate(-135deg); margin-top: 4px; }
    .stop-btn[aria-expanded='true']::after { display: none; }
    .panel { margin: 2px 0 12px 41px; padding: 18px 16px; border-radius: 20px; }
    .p-intro img { display: none; }
    .p-intro h2 { font-size: 20px; margin-top: 0; }
    .p-intro p { font-size: 16px; margin-bottom: 14px; }
    .p-intro .btn { width: 100%; }
    .steps-list li { grid-template-columns: minmax(0, 1fr); }
    .when { padding: 12px 16px 0; font-size: 13.5px; }
    .steps-list a { padding: 2px 16px 12px; }
    .steps-list b { font-size: 16.5px; }
  }
  @media (max-width: 600px) {
    .feature .btn-row .btn { width: 100%; }
    .mini { grid-template-columns: 1fr; }
    .tg { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .dot { transition: none; } }
</style>

<script>
  import { noteSections } from '../data/note.js';

  /*
   * 한 줄의 길: 지점을 누르면 그 지점의 할 일만 보여 줍니다.
   * PC에서는 늘 하나가 열려 있고, 휴대폰에서는 열린 지점을 다시 누르면 접힙니다.
   * 주소 끝에 #after 처럼 들어오면 그 지점을 열어 둡니다.
   */
  const road = document.querySelector<HTMLElement>('[data-road]');
  if (road) {
    const narrow = window.matchMedia('(max-width: 760px)');
    const btns = [...road.querySelectorAll<HTMLButtonElement>('.stop-btn')];
    const open = (btn: HTMLButtonElement | null) => {
      btns.forEach((b) => {
        const on = b === btn;
        b.setAttribute('aria-expanded', String(on));
        (document.getElementById(b.getAttribute('aria-controls')!) as HTMLElement).hidden = !on;
      });
    };
    btns.forEach((b) => b.addEventListener('click', () => {
      const isOpen = b.getAttribute('aria-expanded') === 'true';
      open(isOpen && narrow.matches ? null : b);
    }));
    narrow.addEventListener('change', () => { if (!narrow.matches && !btns.some((b) => b.getAttribute('aria-expanded') === 'true')) open(btns[0]); });
    const alias: Record<string, string> = { after: 'days' };
    const h = location.hash.replace('#', '');
    const target = document.getElementById(`stop-${alias[h] || h}`) as HTMLButtonElement | null;
    if (target && btns.includes(target)) open(target);
  }

  /*
   * 이 기기에 임시저장한 엔딩노트가 있으면, 카드에 실제로 몇 칸 썼는지 보여 줍니다.
   * 내용은 읽어서 칸 수만 세고, 화면에도 항목 이름만 보여 줍니다(쓴 글자는 보여 주지 않음).
   */
  try {
    const raw = localStorage.getItem('dajeongri-note-v1');
    if (raw) {
      const data = JSON.parse(raw);
      const filled = (v: unknown) => Array.isArray(v) ? v.some((r) => Object.values(r).some(Boolean)) : Object.values((v ?? {}) as object).some(Boolean);
      const done = noteSections.filter((s) => filled(data[s.id]));
      const n = done.length;
      const card = document.querySelector<HTMLElement>('[data-note-card]');
      if (card) {
        card.querySelector('[data-nc-label]')!.textContent = '이 기기에 저장된 노트';
        card.querySelector('[data-nc-count]')!.textContent = `${n}/${noteSections.length}`;
        (card.querySelector('.ring') as HTMLElement).style.setProperty('--p', `${Math.round((n / noteSections.length) * 100)}%`);
        const next = noteSections.filter((s) => !filled(data[s.id])).slice(0, 2);
        const list = done.slice(-3).map((s) => `<li class="d"><span class="c"></span>${s.title}</li>`).concat(next.map((s) => `<li><span class="c"></span>${s.title}</li>`));
        card.querySelector('[data-nc-list]')!.innerHTML = list.join('');
      }
      const cta = document.querySelector<HTMLElement>('[data-note-cta]');
      if (cta) cta.textContent = '엔딩노트 이어 쓰기';
    }
  } catch { /* 저장소를 못 쓰는 브라우저: 예시 카드 그대로 */ }
</script>
