---
/*
 * 첫 화면 (2026-10-27 개편, 최종 시안).
 *   위: 카피 + 주 버튼 + 약속 3가지 | 식탁 그림 + 엔딩노트 카드
 *   3분 진단 입구 → 바로 쓸 수 있는 도구 → 확인한 정보만 씁니다 → 마음도 미리 전할 수 있습니다
 * 엔딩노트 카드는 이 기기에 임시저장한 노트가 있으면 실제 진행(몇 칸 썼는지)을,
 * 없으면 "예시" 표시와 함께 보기 그림을 보여 줍니다. 노트 내용은 화면에만 쓰고 어디로도 보내지 않습니다.
 */
import Base from '../layouts/Base.astro';
import { noteSections } from '../data/note.js';
import { checklist } from '../data/checklist.js';
import { guides } from '../data/guides.js';

const checkCount = checklist.reduce((n, g) => n + g.items.length, 0);
const exampleDone = ['me', 'bank', 'insurance', 'contacts'];
const exampleRows = noteSections.filter((s) => exampleDone.includes(s.id)).concat(noteSections.filter((s) => s.id === 'letters'));
---
<Base description="재산·계정·물건·남길 말을 미리 정리하는 무료 엔딩노트와 체크리스트. 3분 진단, 상속 기한 계산기, 유족을 위한 날짜순 안내까지. 작성 내용은 서버에 저장되지 않습니다.">
  <section class="home-hero">
    <div class="wrap hh-grid">
      <div class="hh-copy">
        <span class="tag">무료 · 가입 없이 바로 · 내 기기에만 저장</span>
        <h1>남은 사람이<br />헤매지 않도록,<br /><span>지금 다정하게</span><br />정리해 두세요</h1>
        <p class="lead">차 한 잔 하면서, 한 주에 하나씩. 통장과 보험, 연락할 사람, 남기고 싶은 말까지 한 권에 모아 둡니다.</p>
        <div class="btn-row hh-cta">
          <a class="btn clay" href="/note/" data-note-cta>엔딩노트 쓰기 시작 →</a>
          <a class="btn ghost" href="/check/">3분 진단</a>
        </div>
        <ul class="promise">
          <li><b>회원가입 없음</b><span>바로 시작</span></li>
          <li><b>서버로 안 보냄</b><span>쓴 내용은 내 기기에만</span></li>
          <li><b>Word·인쇄</b><span>종이로 보관</span></li>
        </ul>
      </div>
      <div class="hh-stage">
        <div class="window">
          <p class="bubble">이번 주는 '은행·증권' 칸을 써 볼까요?</p>
          <img src="/illust/hero-table.svg" alt="부모님과 자녀가 식탁에 마주 앉아 엔딩노트를 함께 쓰는 그림" width="640" height="420" />
        </div>
        <a class="note-card" href="/note/" data-note-card>
          <div class="nc-left">
            <span class="nc-k" data-nc-label>예시 · 우리 가족에게</span>
            <strong>나의 엔딩노트</strong>
            <span class="ring" style="--p:31%"><i data-nc-count>4/{noteSections.length}</i></span>
          </div>
          <ul class="nc-list" data-nc-list>
            {exampleRows.map((s) => <li class={exampleDone.includes(s.id) ? 'd' : ''}><span class="c"></span>{s.title}</li>)}
          </ul>
        </a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <section class="quiz-entry">
      <div class="qe-left">
        <p class="qe-step">3분 진단 · 질문 1 / 3</p>
        <h2>어디서부터 시작할지<br />같이 정해 드릴게요</h2>
        <p class="muted">고르시면 그 상황에 맞는 할 일만 순서대로 보여 드립니다. 답은 이 기기에만 남습니다.</p>
      </div>
      <div class="qe-opts">
        <a href="/check/?s=me"><img src="/illust/situ-me.svg" alt="" width="320" height="240" /><span><b>나를 위해 미리</b>건강할 때 천천히</span></a>
        <a href="/check/?s=parents"><img src="/illust/situ-parents.svg" alt="" width="320" height="240" /><span><b>부모님과 함께</b>말 꺼내는 법부터</span></a>
        <a href="/check/?s=urgent"><img src="/illust/situ-time.svg" alt="" width="320" height="240" /><span><b>시간이 많지 않아요</b>꼭 필요한 것만 먼저</span></a>
        <a href="/check/?s=after" class="loss"><img src="/illust/situ-after.svg" alt="" width="320" height="240" /><span><b>가족을 떠나보냈어요</b>기한이 있는 일부터</span></a>
      </div>
    </section>

    <section>
      <h2>바로 쓸 수 있는 도구</h2>
      <p class="muted" style="margin-top:-6px">모두 무료이고, 입력한 내용은 다정리로 보내지지 않습니다.</p>
      <div class="tools3">
        <a class="tool" href="/note/"><span class="num">{noteSections.length}<small>개 항목</small></span><b>엔딩노트 작성기</b><span>아는 것부터 쓰고 Word 파일로 보관</span><span class="go">쓰기 시작 →</span></a>
        <a class="tool" href="/checklist/"><span class="num">{checkCount}<small>가지 할 일</small></span><b>정리 체크리스트</b><span>서류 · 재산 · 디지털 · 관계 순서로 하나씩</span><span class="go">시작하기 →</span></a>
        <a class="tool am" href="/tools/deadlines/"><span class="num">8<small>가지 기한</small></span><b>상속 기한 계산기</b><span>돌아가신 날만 넣으면 마감일을 한 번에</span><span class="go">계산하기 →</span></a>
      </div>
      <div class="mini">
        <a href="/tools/my-procedures/"><span>나에게 필요한 절차만<small>질문에 답하면 할 일 목록</small></span>›</a>
        <a href="/tools/obituary/"><span>부고 문자 만들기<small>문안 고르고 바로 보내기</small></span>›</a>
        <a href="/tools/cards/"><span>휴대폰 잠금 카드 · 지갑 카드<small>인쇄해서 보관</small></span>›</a>
        <a href="/guide/"><span>정리 가이드<small>{guides.length}가지 주제</small></span>›</a>
      </div>
    </section>

    <section class="trust">
      <div>
        <h2>확인한 정보만 씁니다</h2>
        <p>가이드마다 내용 확인일과 출처, 공식 기관 바로가기를 붙입니다. 법이 바뀌면 고친 날짜를 남깁니다.</p>
      </div>
      <ul class="tg">
        <li><b>확인일 표시</b>모든 가이드 맨 위</li>
        <li><b>출처 공개</b>법령·공식 기관</li>
        <li><b>공식 기관 연결</b><a href="/links/">정부24, 건강보험공단 등</a></li>
        <li><b>서버 저장 없음</b><a href="/privacy/">쓴 내용은 내 기기에만</a></li>
      </ul>
    </section>

    <section class="letter">
      <img src="/illust/letter.svg" alt="부모님이 책상에서 편지를 쓰는 그림" width="420" height="320" />
      <div>
        <h2>마음도 미리 전할 수 있습니다</h2>
        <p class="muted">고맙다는 말, 미안하다는 말, 남기고 싶은 부탁. 엔딩노트 마지막 칸 "남기는 말"에 적어 두세요.</p>
      </div>
      <a class="btn" href="/guide/letters/">편지 쓰는 법</a>
    </section>

    <section class="hide-in-app install-row">
      <div>
        <h2>휴대폰에 앱처럼 설치하세요</h2>
        <p class="muted">홈 화면에 다정리 아이콘을 만들어 두면 한 번에 열리고, 인터넷이 없어도 엔딩노트를 쓸 수 있습니다.</p>
      </div>
      <div class="btn-row">
        <button class="btn" type="button" data-install hidden>지금 바로 설치하기</button>
        <a class="btn ghost" href="/app/">설치 방법 보기</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .home-hero { background: linear-gradient(180deg, #fff 0%, var(--bg) 100%); }
  .hh-grid { display: grid; grid-template-columns: 1fr 1.02fr; gap: 40px; align-items: center; padding-top: 52px; padding-bottom: 64px; }
  .tag { display: inline-block; background: var(--mint-t); color: #1f6e55; font-weight: 700; font-size: 15px; padding: 6px 12px; border-radius: 8px; }
  .hh-copy h1 { font-size: clamp(36px, 5.2vw, 56px); letter-spacing: -0.05em; line-height: 1.24; margin: 16px 0 18px; }
  .hh-copy h1 span { color: var(--green-2); }
  .hh-cta { margin: 26px 0 22px; }
  .promise { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin: 0; padding: 0; list-style: none; }
  .promise li { background: #fff; border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px; font-size: 14px; color: var(--ink-soft); line-height: 1.5; }
  .promise b { display: block; font-size: 16px; color: var(--ink); }
  .hh-stage { position: relative; padding-bottom: 150px; }
  .window { position: relative; border-radius: 32px; background: var(--warm); overflow: hidden; }
  .window img { display: block; width: 100%; height: auto; }
  .bubble { position: absolute; left: 22px; top: 18px; margin: 0; background: #fff; border-radius: 16px; padding: 9px 14px; font-size: 14.5px; font-weight: 700; color: var(--green); box-shadow: 0 8px 20px rgba(22, 33, 44, .08); }
  .note-card { position: absolute; left: -28px; bottom: 0; width: min(470px, 92%); background: #fff; border-radius: 20px; box-shadow: 0 24px 60px rgba(22, 33, 44, .16); padding: 18px 20px; transform: rotate(-1.5deg); display: grid; grid-template-columns: 140px 1fr; gap: 14px; align-items: center; text-decoration: none; color: var(--ink); }
  .note-card:hover { color: var(--ink); transform: rotate(-1.5deg) translateY(-2px); }
  .nc-left strong { display: block; font-size: 20px; font-weight: 800; color: var(--green); letter-spacing: -0.03em; margin: 2px 0 8px; line-height: 1.3; }
  .nc-k { font-size: 12.5px; font-weight: 700; color: var(--clay); }
  .ring { width: 70px; height: 70px; border-radius: 50%; background: conic-gradient(var(--amber) 0 var(--p), var(--navy-t) var(--p) 100%); display: grid; place-items: center; }
  .ring i { width: 54px; height: 54px; border-radius: 50%; background: #fff; display: grid; place-items: center; font-style: normal; font-weight: 800; color: var(--green); font-size: 15px; }
  .nc-list { list-style: none; margin: 0; padding: 0; }
  .nc-list li { display: flex; align-items: center; gap: 9px; padding: 5px 0; border-top: 1px dashed var(--line); font-size: 14.5px; }
  .nc-list li:first-child { border-top: 0; }
  .nc-list .c { width: 20px; height: 20px; border-radius: 6px; border: 1.5px solid var(--line); flex: none; display: grid; place-items: center; font-size: 12px; color: #fff; }
  .nc-list li.d .c { background: var(--mint); border-color: var(--mint); }
  .nc-list li.d .c::after { content: '✓'; }

  .quiz-entry { margin-top: 64px; background: var(--bg); border-radius: 28px; padding: 34px 36px; display: grid; grid-template-columns: .8fr 1.5fr; gap: 30px; align-items: center; }
  .qe-step { font-size: 14px; font-weight: 800; color: var(--ink-soft); margin: 0; }
  .quiz-entry h2 { margin: 8px 0 10px; }
  .qe-opts { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .qe-opts a { display: flex; align-items: center; gap: 14px; background: #fff; border: 1.5px solid var(--line); border-radius: 18px; padding: 12px 14px; text-decoration: none; color: var(--ink-soft); font-size: 14.5px; line-height: 1.45; transition: border-color .15s, transform .15s; }
  .qe-opts a:hover { border-color: #c9d6e5; transform: translateY(-2px); }
  .qe-opts img { width: 76px; height: 57px; border-radius: 12px; flex: none; }
  .qe-opts b { display: block; font-size: 17.5px; color: var(--ink); letter-spacing: -0.03em; }
  .qe-opts a.loss { background: var(--clay-soft); border-color: #f2d3ae; }

  .tools3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-top: 18px; }
  .tool { background: #fff; border: 1px solid var(--line); border-radius: 22px; padding: 24px; display: flex; flex-direction: column; gap: 6px; text-decoration: none; color: var(--ink-soft); font-size: 15.5px; transition: border-color .15s, transform .15s, box-shadow .15s; }
  .tool:hover { border-color: #c9d6e5; transform: translateY(-2px); box-shadow: 0 12px 28px rgba(22, 33, 44, .08); color: var(--ink-soft); }
  .tool .num { font-size: 46px; font-weight: 800; color: var(--green); letter-spacing: -0.04em; line-height: 1; }
  .tool .num small { font-size: 18px; margin-left: 6px; }
  .tool b { font-size: 20px; color: var(--ink); margin-top: 4px; }
  .tool .go { margin-top: auto; padding-top: 12px; color: var(--green-2); font-weight: 700; }
  .tool.am .num { color: var(--clay); }
  .mini { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 14px; }
  .mini a { background: var(--bg); border-radius: 16px; padding: 15px 18px; font-weight: 700; font-size: 16.5px; display: flex; justify-content: space-between; align-items: center; gap: 8px; text-decoration: none; color: var(--ink); }
  .mini a:hover { background: var(--navy-t); color: var(--green); }
  .mini small { display: block; color: var(--ink-soft); font-weight: 500; font-size: 14px; }

  .trust { margin-top: 64px; background: var(--green); border-radius: 28px; padding: 40px 44px; display: grid; grid-template-columns: 1.1fr 1fr; gap: 36px; align-items: center; color: #c6d3e2; }
  .trust h2 { color: #fff; margin: 0 0 10px; }
  .trust p { margin: 0; }
  .tg { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; list-style: none; margin: 0; padding: 0; }
  .tg li { background: rgba(255, 255, 255, .08); border-radius: 14px; padding: 14px 16px; font-size: 15px; }
  .tg b { display: block; color: #fff; font-size: 17px; }
  .tg a { color: #c6d3e2; }
  .letter { margin-top: 20px; background: var(--warm); border-radius: 28px; padding: 26px 40px; display: grid; grid-template-columns: 240px 1fr auto; gap: 30px; align-items: center; }
  .letter img { width: 100%; height: auto; border-radius: 18px; }
  .letter h2 { margin: 0 0 6px; color: var(--green); }
  .letter p { margin: 0; }
  .install-row { margin-top: 56px; display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; border-top: 1px solid var(--line); padding-top: 28px; }
  .install-row h2 { margin: 0 0 4px; font-size: 24px; }
  .install-row p { margin: 0; }

  @media (max-width: 960px) {
    .hh-grid { grid-template-columns: 1fr; gap: 24px; padding-top: 28px; padding-bottom: 36px; }
    .hh-stage { padding-bottom: 0; }
    .note-card { position: relative; left: auto; bottom: auto; width: auto; margin: -40px 14px 0; transform: none; grid-template-columns: auto 1fr; }
    .note-card:hover { transform: none; }
    .nc-list { display: none; }
    .nc-left { display: contents; }
    .quiz-entry { grid-template-columns: 1fr; padding: 24px 18px; }
    .tools3 { grid-template-columns: 1fr; }
    .mini { grid-template-columns: 1fr 1fr; }
    .trust { grid-template-columns: 1fr; padding: 28px 22px; }
    .letter { grid-template-columns: 1fr; padding: 22px; }
    .letter img { max-width: 320px; }
  }
  @media (max-width: 600px) {
    .hh-cta .btn { width: 100%; }
    .promise { grid-template-columns: 1fr 1fr 1fr; gap: 6px; }
    .promise li { padding: 10px; font-size: 12.5px; }
    .promise b { font-size: 14px; }
    .qe-opts { grid-template-columns: 1fr; }
    .mini { grid-template-columns: 1fr; }
    .tg { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { noteSections } from '../data/note.js';
  /*
   * 이 기기에 임시저장한 엔딩노트가 있으면, 카드에 실제로 몇 칸 썼는지 보여 줍니다.
   * 내용은 읽어서 칸 수만 세고, 화면에도 항목 이름만 보여 줍니다(쓴 글자는 보여 주지 않음).
   */
  try {
    const raw = localStorage.getItem('dajeongri-note-v1');
    if (raw) {
      const data = JSON.parse(raw);
      const filled = (v: unknown) => Array.isArray(v) ? v.some((r) => Object.values(r).some(Boolean)) : Object.values((v ?? {}) as object).some(Boolean);
      const done = noteSections.filter((s) => filled(data[s.id]));
      const n = done.length;
      const card = document.querySelector<HTMLElement>('[data-note-card]');
      if (card) {
        card.querySelector('[data-nc-label]')!.textContent = '이 기기에 저장된 노트';
        card.querySelector('[data-nc-count]')!.textContent = `${n}/${noteSections.length}`;
        (card.querySelector('.ring') as HTMLElement).style.setProperty('--p', `${Math.round((n / noteSections.length) * 100)}%`);
        const next = noteSections.filter((s) => !filled(data[s.id])).slice(0, 2);
        const list = done.slice(-3).map((s) => `<li class="d"><span class="c"></span>${s.title}</li>`).concat(next.map((s) => `<li><span class="c"></span>${s.title}</li>`));
        card.querySelector('[data-nc-list]')!.innerHTML = list.join('');
      }
      const cta = document.querySelector<HTMLElement>('[data-note-cta]');
      if (cta) cta.textContent = '엔딩노트 이어 쓰기 →';
    }
  } catch { /* 저장소를 못 쓰는 브라우저: 예시 카드 그대로 */ }
</script>
