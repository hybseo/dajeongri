---
import '../styles/global.css';
import { SITE_NAME, GA_ID } from '../site.js';

const { title, description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE_NAME}` : `${SITE_NAME} · 생전정리와 엔딩노트`;
const site = Astro.site?.href.replace(/\/$/, '') ?? '';
const canonical = site ? site + Astro.url.pathname : null;
const path = Astro.url.pathname;
/*
 * 위쪽 메뉴 (사이트맵 4장). match 에 있는 주소로 시작하는 페이지에서 그 메뉴가 켜집니다.
 */
const nav = [
  { href: '/start/', label: '시작하기', match: ['/start/'] },
  { href: '/tools/', label: '정리 도구', match: ['/tools/', '/checklist/', '/note/'] },
  { href: '/guide/', label: '정리 가이드', match: ['/guide/'] },
  { href: '/after/', label: '떠나보낸 후', match: ['/after/'] },
];
/*
 * 휴대폰 하단 탭 메뉴. 엄지로 누르기 쉽게 화면 아래에 둡니다.
 * 탭은 4칸뿐이라 자주 쓰는 기능을 먼저 둡니다. "떠나보낸 후"는 첫 화면 상황 버튼으로 들어갑니다.
 * 나중에 안드로이드 앱으로 감쌀 때도 이 메뉴를 그대로 씁니다.
 */
const tabs = [
  { href: '/', label: '처음', icon: 'M4 11 12 4l8 7v9h-5v-6H9v6H4z', match: [] },
  { href: '/note/', label: '엔딩노트', icon: 'M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h5', match: ['/note/'] },
  { href: '/tools/', label: '정리 도구', icon: 'M5 4h14v16H5zM8 9l2 2 4-4M8 15h8', match: ['/tools/', '/checklist/'] },
  { href: '/guide/', label: '가이드', icon: 'M4 5c3-1 5-1 8 1 3-2 5-2 8-1v14c-3-1-5-1-8 1-3-2-5-2-8-1zM12 6v14', match: ['/guide/', '/after/', '/start/'] },
];
const isActive = (item) => (item.href === '/' ? path === '/' : item.match.some((m) => path.startsWith(m)));
const footLinks = [
  { href: '/about/', label: '다정리 소개' },
  { href: '/faq/', label: '자주 묻는 질문' },
  { href: '/links/', label: '공식 기관 바로가기' },
  { href: '/glossary/', label: '어려운 말 풀이' },
  { href: '/app/', label: '휴대폰에 설치하기' },
  { href: '/privacy/', label: '개인정보 안내' },
];
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={canonical} />}
  {noindex && <meta name="robots" content="noindex" />}

  {/*
    파비콘. 서치잡에서 /favicon.ico 가 없어 네이버 진단에 "접근 불가 페이지"로
    잡힌 일이 있어, 처음부터 ico 파일을 함께 둡니다.
  */}
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="ko_KR" />
  <meta property="og:site_name" content={SITE_NAME} />
  {canonical && <meta property="og:url" content={canonical} />}
  {/* 공유 썸네일은 전체 주소가 있어야 네이버·카카오가 읽습니다. 도메인 확정 후 자동으로 켜집니다. */}
  {site && <meta property="og:image" content={`${site}/og.png`} />}
  {site && <meta property="og:image:width" content="1200" />}
  {site && <meta property="og:image:height" content="630" />}
  <meta name="theme-color" content="#2f4b47" />

  {/* 웹앱(PWA) 설치 정보. 휴대폰 홈 화면에 "다정리" 아이콘으로 설치됩니다. */}
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="다정리" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />

  {/*
    검색엔진 소유확인 값은 네이버 서치어드바이저·구글 서치콘솔에 사이트를
    등록할 때 발급됩니다. 아직 발급 전이라 넣지 않았습니다.
  */}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet" />

  {GA_ID && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
      <script is:inline define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', GA_ID, { anonymize_ip: true });
      </script>
    </>
  )}

  {/*
    글자 크게 보기. 페이지가 그려지기 전에 설정을 읽어 깜빡임 없이 적용합니다.
    설정은 이 기기의 브라우저에만 기억됩니다.
  */}
  <script is:inline>
    try { if (localStorage.getItem('dajeongri-font') === 'large') document.documentElement.dataset.size = 'large'; } catch (e) {}
  </script>
</head>
<body>
  <a class="skip" href="#main">본문으로 건너뛰기</a>
  <header class="site">
    <div class="wrap bar">
      <a class="mark" href="/" aria-label="다정리 처음으로">
        <span class="dot" aria-hidden="true"></span>다정리
      </a>
      <nav class="top-nav" aria-label="주요 메뉴">
        {nav.map((n) => (
          <a href={n.href} aria-current={isActive(n) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
      <div class="head-tools">
        <button class="install-chip" type="button" data-install hidden>앱으로 설치</button>
        <button class="font-btn" type="button" data-font aria-pressed="false" title="글자 크게 보기">
          <span aria-hidden="true">가</span><span class="font-plus" aria-hidden="true">+</span><span class="sr">글자 크게 보기</span>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site">
    <div class="wrap">
      <p class="foot-name">다정리</p>
      <p>이 사이트의 내용은 일반적인 정보 안내입니다. 개별 사안에 대한 법률·세무·의료 상담이 아니며, 실제 절차는 해당 기관과 전문가에게 확인하세요.</p>
      <p>다정리의 도구에 쓴 내용은 이 사이트의 서버로 전송되거나 저장되지 않습니다.</p>
      <nav class="foot-links" aria-label="다정리 안내">
        {footLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>
  </footer>

  <nav class="tabbar" aria-label="하단 메뉴">
    {tabs.map((t) => (
      <a href={t.href} aria-current={isActive(t) ? 'page' : undefined}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={t.icon} /></svg>
        <span>{t.label}</span>
      </a>
    ))}
  </nav>

  {/*
    오프라인 저장(서비스 워커) 등록. 실제 사이트에서만 켭니다.
    개발용 미리보기에서 켜면 고친 내용이 예전 저장본에 가려 헷갈리기 때문입니다.
  */}
  {import.meta.env.PROD && (
    <script is:inline data-sw>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  )}

  <script>
    import { track } from '../scripts/analytics.js';

    /*
     * "앱으로 설치" 버튼.
     * 안드로이드 크롬·삼성 인터넷이 "설치할 수 있다"고 알려 줄 때만 버튼을 보여 줍니다.
     * 그 신호가 없는 브라우저(아이폰 등)에서는 버튼이 숨어 있고, /app/ 안내 페이지를 씁니다.
     */
    /* 글자 크게 보기: 누를 때마다 보통 ↔ 크게. 이 기기에만 기억합니다. */
    const fontBtn = document.querySelector<HTMLButtonElement>('[data-font]');
    const syncFont = () => fontBtn?.setAttribute('aria-pressed', String(document.documentElement.dataset.size === 'large'));
    syncFont();
    fontBtn?.addEventListener('click', () => {
      const large = document.documentElement.dataset.size !== 'large';
      if (large) document.documentElement.dataset.size = 'large'; else delete document.documentElement.dataset.size;
      try { localStorage.setItem('dajeongri-font', large ? 'large' : 'normal'); } catch { /* 저장이 막혀도 화면은 바뀜 */ }
      syncFont();
      track(large ? 'font_large' : 'font_normal');
    });

    /*
     * "가족에게 보내기" 버튼 ([data-share]).
     * 휴대폰의 공유 기능을 열어, 보낼 사람과 앱은 사용자가 직접 고릅니다.
     * 공유 기능이 없는 컴퓨터에서는 페이지 주소를 복사합니다.
     */
    document.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-share]');
      if (!btn) return;
      const data = { title: document.title, url: location.href };
      const done = (msg: string) => { const old = btn.textContent; btn.textContent = msg; setTimeout(() => { btn.textContent = old; }, 2500); };
      try {
        if (navigator.share) { await navigator.share(data); track('share'); return; }
        await navigator.clipboard.writeText(location.href);
        done('주소를 복사했습니다'); track('share_copy');
      } catch { /* 사용자가 공유 창을 닫은 경우 */ }
    });

    let deferred: any = null;
    const buttons = () => Array.from(document.querySelectorAll<HTMLElement>('[data-install]'));
    const standalone = window.matchMedia('(display-mode: standalone)').matches || (navigator as any).standalone === true;
    if (standalone) document.documentElement.classList.add('is-app');

    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferred = e;
      if (!standalone) buttons().forEach((b) => { b.hidden = false; });
    });
    document.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement).closest('[data-install]');
      if (!btn || !deferred) return;
      track('app_install_prompt');
      deferred.prompt();
      await deferred.userChoice.catch(() => null);
      deferred = null;
      buttons().forEach((b) => { b.hidden = true; });
    });
    window.addEventListener('appinstalled', () => {
      track('app_installed');
      buttons().forEach((b) => { b.hidden = true; });
    });
  </script>
</body>
</html>
