---
/*
 * 정리 가이드 공통 틀.
 *
 * checked 는 내용을 마지막으로 공식 출처와 대조한 날입니다. 법과 기관 안내는
 * 바뀔 수 있으니, 내용을 고칠 때마다 이 날짜와 출처 목록도 함께 고쳐 주세요.
 */
import Base from './Base.astro';
import { guides, groups } from '../data/guides.js';

const { title, description, checked, sources = [], slug } = Astro.props;
const me = guides.find((g) => g.slug === slug);
const group = groups.find((g) => g.key === me?.group);
const same = guides.filter((g) => g.group === me?.group && g.slug !== slug);
const others = same.length ? same : guides.filter((g) => g.slug !== slug).slice(0, 3);
/* 묶음마다 맨 위 그림과 함께 볼 도구 (2026-10-27 개편) */
const GROUP_UI = {
  care: { ill: ['situ-time', '자녀가 부모님 어깨를 감싸 안은 그림'], tools: [['/note/', '엔딩노트: 의료와 장례에 대한 바람'], ['/tools/cards/', '지갑 긴급 카드 만들기']] },
  law: { ill: ['costs', '영수증과 계산기'], tools: [['/note/', '엔딩노트: 은행·보험·빚 적기'], ['/tools/deadlines/', '상속 기한 계산기']] },
  digital: { ill: ['cards', '잠긴 휴대폰과 지갑에 넣는 연락 카드'], tools: [['/tools/cards/', '휴대폰 잠금 카드 만들기'], ['/note/', '엔딩노트: 디지털 계정 적기']] },
  funeral: { ill: ['burial', '언덕 위 나무 아래 작은 표지가 있는 그림'], tools: [['/note/', '엔딩노트: 장례에 대한 바람'], ['/tools/obituary/', '부고 문자 만들기']] },
  heart: { ill: ['letter', '부모님이 책상에서 편지를 쓰는 그림'], tools: [['/note/', '엔딩노트: 남기는 말'], ['/check/', '3분 진단']] },
  after: { ill: ['situ-after', '가디건이 걸린 빈 의자와 찻잔이 놓인 조용한 그림'], tools: [['/tools/deadlines/', '상속 기한 계산기'], ['/tools/my-procedures/', '나에게 필요한 절차만']] },
  alone: { ill: ['alone', '창가에 앉은 부모님과 고양이'], tools: [['/tools/cards/', '지갑 긴급 카드 만들기'], ['/note/', '엔딩노트: 꼭 연락해야 할 사람']] },
};
const ui = GROUP_UI[me?.group] ?? GROUP_UI.heart;
const illOverride = me?.ill;
---
<Base title={title} description={description}>
  <article class="wrap narrow article">
    <header class="page-head">
      <img class="page-illust" src={`/illust/${illOverride ? illOverride[0] : ui.ill[0]}.svg`} alt={illOverride ? illOverride[1] : ui.ill[1]} width="320" height="240" />
      <p class="crumb"><a href="/guide/">정리 가이드</a>{group && <> · {group.title}</>}</p>
      <h1>{title}</h1>
      <ul class="badges" aria-label="이 가이드에 대해">
        <li class="ok">✓ 내용 확인 {checked}</li>
        {sources.length > 0 && <li><a href="#sources" style="color:inherit;text-decoration:none">출처 {sources.length}곳</a></li>}
        <li>일반 정보 · 개별 상담 아님</li>
      </ul>
      <div class="share-row no-print">
        <button class="share-btn" type="button" data-share>가족에게 보내기</button>
      </div>
    </header>

    <nav class="toc no-print" aria-label="이 가이드의 순서" data-toc hidden>
      <p>이 가이드의 순서</p>
      <ol></ol>
    </nav>

    <div data-guide-body>
      <slot />
    </div>

    <section class="no-print">
      <h2>함께 쓰면 좋은 도구</h2>
      <div class="related-tools">
        {ui.tools.map(([href, label]) => <a href={href}>{label}<span aria-hidden="true">→</span></a>)}
      </div>
    </section>

    {sources.length > 0 && (
      <section class="sources" id="sources">
        <p><strong>참고한 자료</strong></p>
        <ul>
          {sources.map((s) => <li><a href={s.url} rel="nofollow noopener" target="_blank">{s.title}</a></li>)}
        </ul>
        <p>제도와 기관 안내는 바뀔 수 있습니다. 실제 절차 전에는 해당 기관에 최신 내용을 확인하세요.</p>
      </section>
    )}

    <section class="no-print">
      <h2>{same.length ? `${group?.title} 가이드 더 보기` : '다른 가이드'}</h2>
      <div class="cards">
        {others.map((g) => (
          <a class="card" href={`/guide/${g.slug}/`}>
            <h3>{g.title}</h3>
            <p class="muted">{g.summary}</p>
          </a>
        ))}
      </div>
      <p style="margin-top:16px"><a href="/guide/">가이드 전체 보기 →</a></p>
    </section>
  </article>
</Base>

<style>
  .toc { background: var(--bg); border-radius: 16px; padding: 16px 22px 10px; margin: 8px 0 26px; }
  .toc p { font-weight: 800; color: var(--green); margin: 0 0 6px; font-size: 16px; }
  .toc ol { margin: 0; padding-left: 1.2em; }
  .toc li { margin-bottom: 6px; }
  .toc a { text-decoration: none; }
  .toc a:hover { text-decoration: underline; }
</style>

<script>
  /* 본문 소제목(h2)으로 "이 가이드의 순서"를 만듭니다. 소제목이 3개 이상일 때만 보여 줍니다. */
  const body = document.querySelector('[data-guide-body]');
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  const hs = body ? Array.from(body.querySelectorAll('h2')) : [];
  if (toc && hs.length >= 3) {
    const ol = toc.querySelector('ol')!;
    hs.forEach((h, i) => {
      if (!h.id) h.id = `s${i + 1}`;
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = `#${h.id}`; a.textContent = h.textContent || '';
      li.appendChild(a); ol.appendChild(li);
    });
    toc.hidden = false;
  }
</script>
